DESCRIPTION >
    Bounded on-demand snapshot of agent_session_signals from contributors: session_signal_files, session_signal_messages, session_signal_pull_requests, session_signal_tools.

NODE snapshot
SQL >
    %
    SELECT
        OrgId,
        repo_fingerprint,
        toDate(EventAt) AS EventDate,
        session_pk,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState('', toDateTime64(0, 3)) AS model,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        minState(EventAt) AS StartedAt,
        maxState(EventAt) AS LastEventAt,
        maxState(toDateTime64(0, 3)) AS VendorStartedAt,
        maxState(IngestedAt) AS IngestedAt,
        sumState(toUInt64(0)) AS MessageCount,
        sumState(toUInt64(0)) AS InputTokens,
        sumState(toUInt64(0)) AS OutputTokens,
        sumState(toUInt64(0)) AS CacheReadTokens,
        sumState(toUInt64(0)) AS CacheCreationTokens,
        sumState(toUInt64(0)) AS ReasoningTokens,
        sumState(toUInt64(0)) AS PricedMessageCount,
        sumState(toUInt64(0)) AS TokenCoveredMessageCount,
        sumState(toUInt64(0)) AS CacheCoveredMessageCount,
        sumState(toUInt64(0)) AS MissingModelMessageCount,
        sumState(toUInt64(toString(agent_file_event_fact_versions.source) = '')) AS MissingSourceFactCount,
        sumState(toFloat64(0)) AS CostUsd,
        sumState(toUInt64(0)) AS ToolEventCount,
        sumState(toUInt64(0)) AS ToolSuccessCount,
        sumState(toUInt64(0)) AS ToolFailureCount,
        sumState(toUInt64(0)) AS ToolUnknownCount,
        sumState(toUInt64(0)) AS NavigationToolCount,
        sumState(toUInt64(0)) AS SearchToolCount,
        sumState(toUInt64(0)) AS NavigationHintStructuredCount,
        sumState(toUInt64(0)) AS NavigationHintUnknownCount,
        sumState(toUInt64(0)) AS MissingFileFailureCount,
        sumState(toUInt64(0)) AS ReadDirectoryFailureCount,
        sumState(toUInt64(0)) AS EditBeforeReadFailureCount,
        sumState(toUInt64(0)) AS StaleFileBeforeEditFailureCount,
        sumState(toUInt64(0)) AS ExternalSchemaValidationFailureCount,
        sumState(toUInt64(0)) AS RuntimeEnvMismatchFailureCount,
        sumState(toUInt64(0)) AS ToolInputValidationFailureCount,
        sumState(toUInt64(0)) AS HumanOrPolicyRejectionFailureCount,
        sumState(toUInt64(0)) AS WrongToolNameFailureCount,
        sumState(toUInt64(0)) AS OversizedReadFailureCount,
        sumState(toUInt64(0)) AS OtherFailureCount,
        sumState(toUInt64(0)) AS ClassifiedErrorCategoryFailureCount,
        sumState(toUInt64(0)) AS UnknownErrorCategoryFailureCount,
        sumState(toUInt64(1)) AS FileTouchCount,
        sumState(toUInt64(operation = 'read')) AS ReadFileTouchCount,
        sumState(toUInt64(operation = 'edit')) AS EditFileTouchCount,
        sumState(toUInt64(operation IN ('write', 'create', 'delete', 'rename'))) AS WriteFileTouchCount,
        uniqState(normalized_repo_path) AS UniqueFileCount,
        uniqStateIf('', 0) AS PullRequestLinkCount,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'session_signal_files' AS SourceContributor
    FROM agent_file_event_fact_versions FINAL
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
    GROUP BY OrgId, repo_fingerprint, EventDate, session_pk, SnapshotDay
    UNION ALL
    SELECT
        OrgId,
        repo_fingerprint,
        toDate(EventAt) AS EventDate,
        session_pk,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState(toString(model), EventAt) AS model,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        minState(EventAt) AS StartedAt,
        maxState(EventAt) AS LastEventAt,
        maxState(VendorStartedAt) AS VendorStartedAt,
        maxState(IngestedAt) AS IngestedAt,
        sumState(toUInt64(1)) AS MessageCount,
        sumState(toUInt64(input_tokens)) AS InputTokens,
        sumState(toUInt64(output_tokens)) AS OutputTokens,
        sumState(toUInt64(cache_read_tokens)) AS CacheReadTokens,
        sumState(toUInt64(cache_creation_tokens)) AS CacheCreationTokens,
        sumState(toUInt64(reasoning_tokens)) AS ReasoningTokens,
        sumState(toUInt64(cost_usd IS NOT NULL)) AS PricedMessageCount,
        sumState(toUInt64(token_coverage != 'missing')) AS TokenCoveredMessageCount,
        sumState(toUInt64(cache_coverage != 'missing')) AS CacheCoveredMessageCount,
        sumState(toUInt64(toString(agent_message_fact_versions.model) = '')) AS MissingModelMessageCount,
        sumState(toUInt64(toString(agent_message_fact_versions.source) = '')) AS MissingSourceFactCount,
        sumState(ifNull(cost_usd, 0.)) AS CostUsd,
        sumState(toUInt64(0)) AS ToolEventCount,
        sumState(toUInt64(0)) AS ToolSuccessCount,
        sumState(toUInt64(0)) AS ToolFailureCount,
        sumState(toUInt64(0)) AS ToolUnknownCount,
        sumState(toUInt64(0)) AS NavigationToolCount,
        sumState(toUInt64(0)) AS SearchToolCount,
        sumState(toUInt64(0)) AS NavigationHintStructuredCount,
        sumState(toUInt64(0)) AS NavigationHintUnknownCount,
        sumState(toUInt64(0)) AS MissingFileFailureCount,
        sumState(toUInt64(0)) AS ReadDirectoryFailureCount,
        sumState(toUInt64(0)) AS EditBeforeReadFailureCount,
        sumState(toUInt64(0)) AS StaleFileBeforeEditFailureCount,
        sumState(toUInt64(0)) AS ExternalSchemaValidationFailureCount,
        sumState(toUInt64(0)) AS RuntimeEnvMismatchFailureCount,
        sumState(toUInt64(0)) AS ToolInputValidationFailureCount,
        sumState(toUInt64(0)) AS HumanOrPolicyRejectionFailureCount,
        sumState(toUInt64(0)) AS WrongToolNameFailureCount,
        sumState(toUInt64(0)) AS OversizedReadFailureCount,
        sumState(toUInt64(0)) AS OtherFailureCount,
        sumState(toUInt64(0)) AS ClassifiedErrorCategoryFailureCount,
        sumState(toUInt64(0)) AS UnknownErrorCategoryFailureCount,
        sumState(toUInt64(0)) AS FileTouchCount,
        sumState(toUInt64(0)) AS ReadFileTouchCount,
        sumState(toUInt64(0)) AS EditFileTouchCount,
        sumState(toUInt64(0)) AS WriteFileTouchCount,
        uniqStateIf('', 0) AS UniqueFileCount,
        uniqStateIf('', 0) AS PullRequestLinkCount,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'session_signal_messages' AS SourceContributor
    FROM agent_message_fact_versions FINAL
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
      AND role = 'assistant'
    GROUP BY OrgId, repo_fingerprint, EventDate, session_pk, SnapshotDay
    UNION ALL
    SELECT
        OrgId,
        repo_fingerprint,
        toDate(EventAt) AS EventDate,
        session_pk,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState('', toDateTime64(0, 3)) AS model,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        minState(EventAt) AS StartedAt,
        maxState(EventAt) AS LastEventAt,
        maxState(toDateTime64(0, 3)) AS VendorStartedAt,
        maxState(IngestedAt) AS IngestedAt,
        sumState(toUInt64(0)) AS MessageCount,
        sumState(toUInt64(0)) AS InputTokens,
        sumState(toUInt64(0)) AS OutputTokens,
        sumState(toUInt64(0)) AS CacheReadTokens,
        sumState(toUInt64(0)) AS CacheCreationTokens,
        sumState(toUInt64(0)) AS ReasoningTokens,
        sumState(toUInt64(0)) AS PricedMessageCount,
        sumState(toUInt64(0)) AS TokenCoveredMessageCount,
        sumState(toUInt64(0)) AS CacheCoveredMessageCount,
        sumState(toUInt64(0)) AS MissingModelMessageCount,
        sumState(toUInt64(toString(agent_pull_request_fact_versions.source) = '')) AS MissingSourceFactCount,
        sumState(toFloat64(0)) AS CostUsd,
        sumState(toUInt64(0)) AS ToolEventCount,
        sumState(toUInt64(0)) AS ToolSuccessCount,
        sumState(toUInt64(0)) AS ToolFailureCount,
        sumState(toUInt64(0)) AS ToolUnknownCount,
        sumState(toUInt64(0)) AS NavigationToolCount,
        sumState(toUInt64(0)) AS SearchToolCount,
        sumState(toUInt64(0)) AS NavigationHintStructuredCount,
        sumState(toUInt64(0)) AS NavigationHintUnknownCount,
        sumState(toUInt64(0)) AS MissingFileFailureCount,
        sumState(toUInt64(0)) AS ReadDirectoryFailureCount,
        sumState(toUInt64(0)) AS EditBeforeReadFailureCount,
        sumState(toUInt64(0)) AS StaleFileBeforeEditFailureCount,
        sumState(toUInt64(0)) AS ExternalSchemaValidationFailureCount,
        sumState(toUInt64(0)) AS RuntimeEnvMismatchFailureCount,
        sumState(toUInt64(0)) AS ToolInputValidationFailureCount,
        sumState(toUInt64(0)) AS HumanOrPolicyRejectionFailureCount,
        sumState(toUInt64(0)) AS WrongToolNameFailureCount,
        sumState(toUInt64(0)) AS OversizedReadFailureCount,
        sumState(toUInt64(0)) AS OtherFailureCount,
        sumState(toUInt64(0)) AS ClassifiedErrorCategoryFailureCount,
        sumState(toUInt64(0)) AS UnknownErrorCategoryFailureCount,
        sumState(toUInt64(0)) AS FileTouchCount,
        sumState(toUInt64(0)) AS ReadFileTouchCount,
        sumState(toUInt64(0)) AS EditFileTouchCount,
        sumState(toUInt64(0)) AS WriteFileTouchCount,
        uniqStateIf('', 0) AS UniqueFileCount,
        uniqState(url) AS PullRequestLinkCount,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'session_signal_pull_requests' AS SourceContributor
    FROM agent_pull_request_fact_versions FINAL
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
      AND url != ''
    GROUP BY OrgId, repo_fingerprint, EventDate, session_pk, SnapshotDay
    UNION ALL
    SELECT
        OrgId,
        repo_fingerprint,
        toDate(EventAt) AS EventDate,
        session_pk,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState('', toDateTime64(0, 3)) AS model,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        minState(EventAt) AS StartedAt,
        maxState(EventAt) AS LastEventAt,
        maxState(toDateTime64(0, 3)) AS VendorStartedAt,
        maxState(IngestedAt) AS IngestedAt,
        sumState(toUInt64(0)) AS MessageCount,
        sumState(toUInt64(0)) AS InputTokens,
        sumState(toUInt64(0)) AS OutputTokens,
        sumState(toUInt64(0)) AS CacheReadTokens,
        sumState(toUInt64(0)) AS CacheCreationTokens,
        sumState(toUInt64(0)) AS ReasoningTokens,
        sumState(toUInt64(0)) AS PricedMessageCount,
        sumState(toUInt64(0)) AS TokenCoveredMessageCount,
        sumState(toUInt64(0)) AS CacheCoveredMessageCount,
        sumState(toUInt64(0)) AS MissingModelMessageCount,
        sumState(toUInt64(toString(agent_tool_event_fact_versions.source) = '')) AS MissingSourceFactCount,
        sumState(toFloat64(0)) AS CostUsd,
        sumState(toUInt64(1)) AS ToolEventCount,
        sumState(toUInt64(status = 'success')) AS ToolSuccessCount,
        sumState(toUInt64(status = 'failure')) AS ToolFailureCount,
        sumState(toUInt64(status = 'unknown')) AS ToolUnknownCount,
        sumState(toUInt64(is_navigation = 1)) AS NavigationToolCount,
        sumState(toUInt64(is_navigation = 1 AND (navigation_kind = 'search' OR command_family IN ('rg', 'grep', 'find', 'fd')))) AS SearchToolCount,
        sumState(toUInt64(is_navigation = 1 AND navigation_hint_coverage = 'structured')) AS NavigationHintStructuredCount,
        sumState(toUInt64(is_navigation = 1 AND navigation_hint_coverage = 'unknown')) AS NavigationHintUnknownCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'missing_file')) AS MissingFileFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'read_directory')) AS ReadDirectoryFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'edit_before_read')) AS EditBeforeReadFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'stale_file_before_edit')) AS StaleFileBeforeEditFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'external_schema_validation')) AS ExternalSchemaValidationFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'runtime_env_mismatch')) AS RuntimeEnvMismatchFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'tool_input_validation')) AS ToolInputValidationFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'human_or_policy_rejection')) AS HumanOrPolicyRejectionFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'wrong_tool_name')) AS WrongToolNameFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'oversized_read')) AS OversizedReadFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category = 'other')) AS OtherFailureCount,
        sumState(toUInt64(status = 'failure' AND error_category_coverage = 'classified')) AS ClassifiedErrorCategoryFailureCount,
        sumState(toUInt64(status = 'failure' AND (error_category_coverage = 'unknown' OR error_category = 'unknown'))) AS UnknownErrorCategoryFailureCount,
        sumState(toUInt64(0)) AS FileTouchCount,
        sumState(toUInt64(0)) AS ReadFileTouchCount,
        sumState(toUInt64(0)) AS EditFileTouchCount,
        sumState(toUInt64(0)) AS WriteFileTouchCount,
        uniqStateIf('', 0) AS UniqueFileCount,
        uniqStateIf('', 0) AS PullRequestLinkCount,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'session_signal_tools' AS SourceContributor
    FROM agent_tool_event_fact_versions FINAL
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
    GROUP BY OrgId, repo_fingerprint, EventDate, session_pk, SnapshotDay
    SETTINGS max_threads = 1

TYPE COPY
TARGET_DATASOURCE agent_session_signals_snapshots
COPY_MODE append

TOKEN agent_snapshot_worker READ
