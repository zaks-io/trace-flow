DESCRIPTION >
    Bounded on-demand snapshot of agent_session_summaries from contributors: session_files, session_messages, session_pull_requests, session_tools.

NODE snapshot
SQL >
    %
    SELECT
        OrgId,
        session_pk,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(UserId, EventAt) AS UserId,
        argMaxState(CollectorId, EventAt) AS CollectorId,
        argMaxState(CollectorCredentialId, EventAt) AS CollectorCredentialId,
        argMaxState(repo_fingerprint, EventAt) AS repo_fingerprint,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState('', toDateTime64(0, 3)) AS model,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        minState(EventAt) AS StartedAt,
        maxState(EventAt) AS LastEventAt,
        maxState(toDateTime64(0, 3)) AS VendorStartedAt,
        maxState(IngestedAt) AS IngestedAt,
        argMaxState('', toDateTime64(0, 3)) AS git_branch,
        argMaxState('', toDateTime64(0, 3)) AS git_head_sha,
        argMaxState('', toDateTime64(0, 3)) AS primary_pull_request_url,
        sumState(toUInt64(0)) AS MessageCount,
        sumState(toUInt64(0)) AS ToolEventCount,
        sumState(toUInt64(1)) AS FileEventCount,
        uniqState(normalized_repo_path) AS UniqueFileCount,
        sumState(toUInt64(0)) AS FailureCount,
        sumState(toUInt64(0)) AS InputTokens,
        sumState(toUInt64(0)) AS OutputTokens,
        sumState(toUInt64(0)) AS CacheReadTokens,
        sumState(toUInt64(0)) AS CacheCreationTokens,
        sumState(toUInt64(0)) AS ReasoningTokens,
        sumState(toUInt64(0)) AS PricedMessageCount,
        sumState(toFloat64(0)) AS CostUsd,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'session_files' AS SourceContributor
    FROM agent_file_event_fact_versions FINAL
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
    GROUP BY OrgId, session_pk, SnapshotDay
    UNION ALL
    SELECT
        OrgId,
        session_pk,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(UserId, EventAt) AS UserId,
        argMaxState(CollectorId, EventAt) AS CollectorId,
        argMaxState(CollectorCredentialId, EventAt) AS CollectorCredentialId,
        argMaxState(repo_fingerprint, EventAt) AS repo_fingerprint,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState(toString(model), EventAt) AS model,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        minState(EventAt) AS StartedAt,
        maxState(EventAt) AS LastEventAt,
        maxState(VendorStartedAt) AS VendorStartedAt,
        maxState(IngestedAt) AS IngestedAt,
        argMaxState(git_branch, EventAt) AS git_branch,
        argMaxState(git_head_sha, EventAt) AS git_head_sha,
        argMaxState('', toDateTime64(0, 3)) AS primary_pull_request_url,
        sumState(toUInt64(1)) AS MessageCount,
        sumState(toUInt64(0)) AS ToolEventCount,
        sumState(toUInt64(0)) AS FileEventCount,
        uniqStateIf('', 0) AS UniqueFileCount,
        sumState(toUInt64(0)) AS FailureCount,
        sumState(toUInt64(input_tokens)) AS InputTokens,
        sumState(toUInt64(output_tokens)) AS OutputTokens,
        sumState(toUInt64(cache_read_tokens)) AS CacheReadTokens,
        sumState(toUInt64(cache_creation_tokens)) AS CacheCreationTokens,
        sumState(toUInt64(reasoning_tokens)) AS ReasoningTokens,
        sumState(toUInt64(cost_usd IS NOT NULL)) AS PricedMessageCount,
        sumState(ifNull(cost_usd, 0.)) AS CostUsd,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'session_messages' AS SourceContributor
    FROM agent_message_fact_versions FINAL
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
      AND role = 'assistant'
    GROUP BY OrgId, session_pk, SnapshotDay
    UNION ALL
    SELECT
        OrgId,
        session_pk,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(UserId, EventAt) AS UserId,
        argMaxState(CollectorId, EventAt) AS CollectorId,
        argMaxState(CollectorCredentialId, EventAt) AS CollectorCredentialId,
        argMaxState(repo_fingerprint, EventAt) AS repo_fingerprint,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState('', toDateTime64(0, 3)) AS model,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        minState(EventAt) AS StartedAt,
        maxState(EventAt) AS LastEventAt,
        maxState(toDateTime64(0, 3)) AS VendorStartedAt,
        maxState(IngestedAt) AS IngestedAt,
        argMaxState('', toDateTime64(0, 3)) AS git_branch,
        argMaxState('', toDateTime64(0, 3)) AS git_head_sha,
        argMaxState('', toDateTime64(0, 3)) AS primary_pull_request_url,
        sumState(toUInt64(0)) AS MessageCount,
        sumState(toUInt64(0)) AS ToolEventCount,
        sumState(toUInt64(0)) AS FileEventCount,
        uniqStateIf('', 0) AS UniqueFileCount,
        sumState(toUInt64(0)) AS FailureCount,
        sumState(toUInt64(0)) AS InputTokens,
        sumState(toUInt64(0)) AS OutputTokens,
        sumState(toUInt64(0)) AS CacheReadTokens,
        sumState(toUInt64(0)) AS CacheCreationTokens,
        sumState(toUInt64(0)) AS ReasoningTokens,
        sumState(toUInt64(0)) AS PricedMessageCount,
        sumState(toFloat64(0)) AS CostUsd,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'session_pull_requests' AS SourceContributor
    FROM agent_pull_request_fact_versions FINAL
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
      AND url != ''
    GROUP BY OrgId, session_pk, SnapshotDay
    UNION ALL
    SELECT
        OrgId,
        session_pk,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(UserId, EventAt) AS UserId,
        argMaxState(CollectorId, EventAt) AS CollectorId,
        argMaxState(CollectorCredentialId, EventAt) AS CollectorCredentialId,
        argMaxState(repo_fingerprint, EventAt) AS repo_fingerprint,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState('', toDateTime64(0, 3)) AS model,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        minState(EventAt) AS StartedAt,
        maxState(EventAt) AS LastEventAt,
        maxState(toDateTime64(0, 3)) AS VendorStartedAt,
        maxState(IngestedAt) AS IngestedAt,
        argMaxState('', toDateTime64(0, 3)) AS git_branch,
        argMaxState('', toDateTime64(0, 3)) AS git_head_sha,
        argMaxState('', toDateTime64(0, 3)) AS primary_pull_request_url,
        sumState(toUInt64(0)) AS MessageCount,
        sumState(toUInt64(1)) AS ToolEventCount,
        sumState(toUInt64(0)) AS FileEventCount,
        uniqStateIf('', 0) AS UniqueFileCount,
        sumState(toUInt64(status = 'failure')) AS FailureCount,
        sumState(toUInt64(0)) AS InputTokens,
        sumState(toUInt64(0)) AS OutputTokens,
        sumState(toUInt64(0)) AS CacheReadTokens,
        sumState(toUInt64(0)) AS CacheCreationTokens,
        sumState(toUInt64(0)) AS ReasoningTokens,
        sumState(toUInt64(0)) AS PricedMessageCount,
        sumState(toFloat64(0)) AS CostUsd,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'session_tools' AS SourceContributor
    FROM agent_tool_event_fact_versions FINAL
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
    GROUP BY OrgId, session_pk, SnapshotDay
    SETTINGS max_threads = 1

TYPE COPY
TARGET_DATASOURCE agent_session_summaries_snapshots
COPY_MODE append

TOKEN agent_snapshot_worker READ
