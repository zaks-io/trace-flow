DESCRIPTION >
    Bounded on-demand snapshot of agent_session_file_signals from contributors: session_file_signal_hints, session_file_signals.

NODE snapshot
SQL >
    %
    SELECT
        OrgId,
        repo_fingerprint,
        session_pk,
        normalized_path AS normalized_repo_path,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        maxState(path_confidence_rank) AS PathConfidenceRank,
        minState(EventAt) AS FirstTouchedAt,
        maxState(EventAt) AS LastTouchedAt,
        maxState(IngestedAt) AS IngestedAt,
        sumState(toUInt64(1)) AS TouchCount,
        sumState(toUInt64(0)) AS ReadCount,
        sumState(toUInt64(0)) AS EditCount,
        sumState(toUInt64(0)) AS WriteCount,
        sumState(toUInt64(error_category = 'read_directory')) AS DirectoryReadCount,
        sumState(toUInt64(error_category = 'missing_file')) AS MissingFileCount,
        sumState(toUInt64(1)) AS CoverageDebtCount,
        sumState(toUInt64(0)) AS StructuredFileEventCount,
        sumState(toUInt64(1)) AS HintEventCount,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'session_file_signal_hints' AS SourceContributor
    FROM (
        SELECT
            *,
            arrayJoin(if(length(path_candidates) = 0, [''], path_candidates)) AS raw_path,
            multiIf(
                raw_path = '', 'unknown_path',
                dropped_sensitive > 0 OR startsWith(raw_path, '/'), 'unsafe_path',
                raw_path = 'outside_repo', 'outside_repo',
                replaceRegexpAll(raw_path, '^\\./+', '')
            ) AS normalized_path,
            toUInt8(if(normalized_path IN ('unknown_path', 'unsafe_path', 'outside_repo'), 1, 2)) AS path_confidence_rank
        FROM (
            SELECT
                *,
                arrayDistinct(arrayConcat(
                    repo_relative_paths,
                    if(
                        navigation_hint_coverage = 'structured' AND navigation_path_hint != '',
                        [navigation_path_hint],
                        CAST([], 'Array(String)')
                    )
                )) AS path_candidates
            FROM agent_tool_event_fact_versions FINAL
            WHERE OrgId = {{ String(org_id) }}
              AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
              AND IsDeleted = 0
              AND error_category IN ('missing_file', 'read_directory')
        )
    )
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
    GROUP BY OrgId, repo_fingerprint, session_pk, normalized_path, SnapshotDay
    UNION ALL
    SELECT
        OrgId,
        repo_fingerprint,
        session_pk,
        normalized_path AS normalized_repo_path,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        maxState(path_confidence_rank) AS PathConfidenceRank,
        minState(EventAt) AS FirstTouchedAt,
        maxState(EventAt) AS LastTouchedAt,
        maxState(IngestedAt) AS IngestedAt,
        sumState(toUInt64(1)) AS TouchCount,
        sumState(toUInt64(operation = 'read')) AS ReadCount,
        sumState(toUInt64(operation = 'edit')) AS EditCount,
        sumState(toUInt64(operation IN ('write', 'create', 'delete', 'rename'))) AS WriteCount,
        sumState(toUInt64(operation = 'read' AND endsWith(normalized_path, '/'))) AS DirectoryReadCount,
        sumState(toUInt64(0)) AS MissingFileCount,
        sumState(toUInt64(path_confidence_rank < 3)) AS CoverageDebtCount,
        sumState(toUInt64(1)) AS StructuredFileEventCount,
        sumState(toUInt64(0)) AS HintEventCount,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'session_file_signals' AS SourceContributor
    FROM (
        SELECT
            *,
            multiIf(
                normalized_repo_path = '', 'unknown_path',
                dropped_sensitive > 0 OR startsWith(normalized_repo_path, '/'), 'unsafe_path',
                normalized_repo_path = 'outside_repo', 'outside_repo',
                replaceRegexpAll(normalized_repo_path, '^\\./+', '') = '', 'unknown_path',
                replaceRegexpAll(normalized_repo_path, '^\\./+', '')
            ) AS normalized_path,
            toUInt8(if(normalized_path IN ('unknown_path', 'unsafe_path', 'outside_repo'), 1, 3)) AS path_confidence_rank
        FROM agent_file_event_fact_versions FINAL
        WHERE OrgId = {{ String(org_id) }}
          AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
          AND IsDeleted = 0
    )
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
    GROUP BY OrgId, repo_fingerprint, session_pk, normalized_path, SnapshotDay
    SETTINGS max_threads = 1

TYPE COPY
TARGET_DATASOURCE agent_session_file_signals_snapshots
COPY_MODE append

TOKEN agent_snapshot_worker READ
TOKEN trace_flow_agent_snapshot_worker READ
