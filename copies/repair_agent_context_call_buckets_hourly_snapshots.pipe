DESCRIPTION >
    Bounded on-demand snapshot of agent_context_call_buckets_hourly from contributors: context_call_buckets_hourly.

NODE snapshot
SQL >
    %
    SELECT
        toStartOfHour(toDateTime(EventAt)) AS BucketStart,
        OrgId,
        source,
        model,
        repo_fingerprint,
        session_pk,
        toUInt64(input_tokens) + toUInt64(cache_read_tokens) + toUInt64(cache_creation_tokens) AS context_tokens,
        countState() AS CallCount,
        quantileExactState(0.5)(context_tokens) AS ContextP50,
        quantileExactState(0.9)(context_tokens) AS ContextP90,
        quantileExactState(0.95)(context_tokens) AS ContextP95,
        minState(turn_index) AS FirstTurnIndex,
        sumState(toUInt64(output_tokens)) AS OutputTokens,
        sumState(ifNull(cost_usd, 0.)) AS CostUsd,
        toDate(EventAt) AS SnapshotDay,
        {{ UInt64(snapshot_generation) }} AS SnapshotGeneration,
        {{ UInt64(copy_attempt) }} AS CopyAttempt,
        'context_call_buckets_hourly' AS SourceContributor
    FROM agent_message_fact_versions FINAL
    WHERE OrgId = {{ String(org_id) }}
      AND toDate(EventAt) IN {{ Array(snapshot_days, 'Date') }}
      AND IsDeleted = 0
      AND role = 'assistant'
        AND token_coverage != 'missing'
    GROUP BY BucketStart, OrgId, source, model, repo_fingerprint, session_pk, context_tokens, SnapshotDay
    SETTINGS max_threads = 1

TYPE COPY
TARGET_DATASOURCE agent_context_call_buckets_hourly_snapshots
COPY_MODE append

TOKEN agent_snapshot_worker READ
TOKEN trace_flow_agent_snapshot_worker READ
