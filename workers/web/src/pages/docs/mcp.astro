---
import DocsLayout from '@/layouts/DocsLayout.astro';
import CodeBlock from '@/components/docs/CodeBlock.astro';

const CLAUDE_CODE_CONFIG = `{
  "mcpServers": {
    "trace-flow": {
      "type": "http",
      "url": "https://mcp.trace-flow.dev/mcp"
    }
  }
}`;

const LIST_TRACES_RESPONSE = `{
  "traces": [
    {
      "trace_id": "a1b2c3d4e5f6789012345678abcdef01",
      "timestamp": "2025-01-15T14:32:01.000Z",
      "duration_ms": 1847,
      "status": "ok",
      "provider": "openai",
      "model": "gpt-4o",
      "tokens": { "prompt": 1250, "completion": 342, "total": 1592 },
      "cost_usd": 0.0234
    }
  ],
  "pagination": { "has_more": true, "next_cursor": "...", "limit": 10 }
}`;

const GET_TRACE_RESPONSE = `{
  "trace_id": "a1b2c3d4e5f6789012345678abcdef01",
  "root_span": {
    "provider": "openai",
    "model": "gpt-4o",
    "duration_ms": 1847,
    "status": "ok",
    "tokens": { "prompt": 1250, "completion": 342, "total": 1592 },
    "cost_usd": { "input": 0.0125, "output": 0.0109, "total": 0.0234 }
  },
  "spans": [
    {
      "span_id": "abc123...",
      "name": "chat",
      "duration_ms": 1847,
      "attributes": {
        "gen_ai.system": "openai",
        "gen_ai.request.model": "gpt-4o",
        "http.response.status_code": "200",
        "gen_ai.server.time_to_first_token": "423"
      }
    }
  ],
  "span_count": 1
}`;
---

<DocsLayout title="MCP Server - Trace Flow Docs">
  <!-- Hero -->
  <div class="mb-16 animate-fade-in">
    <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-[oklch(0.7_0.18_280)]/20 bg-[oklch(0.7_0.18_280)]/5 px-3 py-1">
      <svg class="h-3.5 w-3.5 text-[oklch(0.7_0.18_280)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
        <line x1="12" x2="12" y1="22.08" y2="12" />
      </svg>
      <span class="font-mono text-xs text-[oklch(0.7_0.18_280)]">MCP Server</span>
    </div>
    <h1 class="mb-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
      Query Traces from Your AI Agent
    </h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      Give Claude Code, Cursor, or any MCP-compatible agent direct access to your LLM trace data.
      Debug production issues, analyze costs, and understand token usage without leaving your editor.
    </p>
  </div>

  <!-- Why MCP -->
  <div class="mb-12 animate-fade-in" style="animation-delay: 100ms;">
    <div class="rounded-xl border border-[oklch(0.7_0.18_280)]/20 bg-[oklch(0.7_0.18_280)]/5 p-6">
      <h3 class="mb-4 flex items-center gap-2 text-sm font-medium uppercase tracking-wider text-[oklch(0.7_0.18_280)]">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </svg>
        Why MCP?
      </h3>
      <p class="text-foreground">
        The <strong>Model Context Protocol</strong> lets AI agents call tools directly. Instead of copying trace IDs
        from your dashboard, your agent can query traces, find errors, and analyze costs in real-time—all while
        helping you debug or optimize your LLM workflows.
      </p>
    </div>
  </div>

  <!-- Agent Setup -->
  <div class="mb-12 animate-fade-in" style="animation-delay: 150ms;">
    <h2 class="mb-6 text-sm font-medium uppercase tracking-wider text-muted-foreground">
      Setup Your Agent
    </h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Claude Code -->
      <div class="rounded-xl border border-border/50 bg-card/50 p-5">
        <div class="mb-3 flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-[oklch(0.75_0.12_50)]/10 text-[oklch(0.75_0.12_50)]">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M13.827 3.52h3.603L24 20h-3.603l-6.57-16.48zm-7.258 0h3.767L16.906 20h-3.674l-1.343-3.461H5.017l-1.344 3.46H0L6.57 3.522zm3.174 3.662L6.53 13.641h6.441l-3.228-6.46z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-foreground">Claude Code</h3>
        </div>
        <p class="mb-3 text-sm text-muted-foreground">
          Add to <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">.mcp.json</code> in your project root:
        </p>
        <div class="rounded-lg bg-muted/50 p-2">
          <code class="font-mono text-xs text-muted-foreground break-all">https://mcp.trace-flow.dev/mcp</code>
        </div>
      </div>

      <!-- Cursor -->
      <div class="rounded-xl border border-border/50 bg-card/50 p-5">
        <div class="mb-3 flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-[oklch(0.7_0.15_262)]/10 text-[oklch(0.7_0.15_262)]">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m4 4 7.07 17 2.51-7.39L21 11.07z" />
            </svg>
          </div>
          <h3 class="font-semibold text-foreground">Cursor</h3>
        </div>
        <p class="mb-3 text-sm text-muted-foreground">
          Add to your MCP settings in <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">~/.cursor/mcp.json</code>:
        </p>
        <div class="rounded-lg bg-muted/50 p-2">
          <code class="font-mono text-xs text-muted-foreground break-all">https://mcp.trace-flow.dev/mcp</code>
        </div>
      </div>

      <!-- Other -->
      <div class="rounded-xl border border-border/50 bg-card/50 p-5">
        <div class="mb-3 flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
            </svg>
          </div>
          <h3 class="font-semibold text-foreground">Other MCP Clients</h3>
        </div>
        <p class="text-sm text-muted-foreground">
          Any MCP-compatible client can connect via HTTP. Use the endpoint URL in your client's MCP configuration.
        </p>
      </div>
    </div>
  </div>

  <!-- Configuration -->
  <div class="mb-12 animate-fade-in" style="animation-delay: 200ms;">
    <h2 class="mb-4 text-sm font-medium uppercase tracking-wider text-muted-foreground">
      Configuration
    </h2>
    <p class="mb-4 text-muted-foreground">
      Add this to your MCP configuration file:
    </p>
    <CodeBlock code={CLAUDE_CODE_CONFIG} lang="json" />
    <div class="mt-4 rounded-lg border border-border/50 bg-card/30 p-4">
      <p class="text-sm text-muted-foreground">
        <strong class="text-foreground">First-time setup:</strong> When your agent first uses the MCP server,
        you'll be prompted to authenticate via OAuth. This links the MCP server to your Trace Flow account.
      </p>
    </div>
  </div>

  <!-- Available Tools -->
  <div class="space-y-12">
    <section class="animate-fade-in" style="animation-delay: 250ms;">
      <div class="mb-6 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[oklch(0.7_0.18_280)]/10 text-lg font-bold text-[oklch(0.7_0.18_280)]">
          1
        </div>
        <h2 class="text-xl font-semibold tracking-tight text-foreground">list_traces</h2>
      </div>
      <p class="mb-4 text-muted-foreground">
        Query recent LLM traces with optional filtering by provider, model, or status. Returns paginated results.
      </p>

      <!-- Parameters Table -->
      <div class="mb-6 rounded-xl border border-border/50 bg-card/50 p-6">
        <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-muted-foreground">
          Parameters
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border/50 text-left">
                <th class="pb-3 font-medium text-muted-foreground">Parameter</th>
                <th class="pb-3 font-medium text-muted-foreground">Type</th>
                <th class="pb-3 font-medium text-muted-foreground">Description</th>
              </tr>
            </thead>
            <tbody class="font-mono text-xs">
              <tr class="border-b border-border/30">
                <td class="py-3 text-[oklch(0.7_0.18_280)]">provider</td>
                <td class="py-3 text-muted-foreground">string</td>
                <td class="py-3 text-foreground font-sans">Filter by AI provider (openai, anthropic, google)</td>
              </tr>
              <tr class="border-b border-border/30">
                <td class="py-3 text-[oklch(0.7_0.18_280)]">model</td>
                <td class="py-3 text-muted-foreground">string</td>
                <td class="py-3 text-foreground font-sans">Filter by model name (gpt-4o, claude-sonnet-4-20250514)</td>
              </tr>
              <tr class="border-b border-border/30">
                <td class="py-3 text-[oklch(0.7_0.18_280)]">status</td>
                <td class="py-3 text-muted-foreground">enum</td>
                <td class="py-3 text-foreground font-sans">STATUS_CODE_OK or STATUS_CODE_ERROR</td>
              </tr>
              <tr class="border-b border-border/30">
                <td class="py-3 text-[oklch(0.7_0.18_280)]">hours</td>
                <td class="py-3 text-muted-foreground">number</td>
                <td class="py-3 text-foreground font-sans">Look back period in hours (default 24, max 168)</td>
              </tr>
              <tr class="border-b border-border/30">
                <td class="py-3 text-[oklch(0.7_0.18_280)]">limit</td>
                <td class="py-3 text-muted-foreground">number</td>
                <td class="py-3 text-foreground font-sans">Max results to return (default 10, max 25)</td>
              </tr>
              <tr>
                <td class="py-3 text-[oklch(0.7_0.18_280)]">cursor</td>
                <td class="py-3 text-muted-foreground">string</td>
                <td class="py-3 text-foreground font-sans">Pagination cursor from previous response</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <h4 class="mb-3 text-sm font-medium text-muted-foreground">Example Response</h4>
      <CodeBlock code={LIST_TRACES_RESPONSE} lang="json" />
    </section>

    <section class="animate-fade-in" style="animation-delay: 300ms;">
      <div class="mb-6 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[oklch(0.7_0.18_280)]/10 text-lg font-bold text-[oklch(0.7_0.18_280)]">
          2
        </div>
        <h2 class="text-xl font-semibold tracking-tight text-foreground">get_trace</h2>
      </div>
      <p class="mb-4 text-muted-foreground">
        Get detailed information about a specific trace including all spans, tokens, costs, and timing.
      </p>

      <!-- Parameters Table -->
      <div class="mb-6 rounded-xl border border-border/50 bg-card/50 p-6">
        <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-muted-foreground">
          Parameters
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border/50 text-left">
                <th class="pb-3 font-medium text-muted-foreground">Parameter</th>
                <th class="pb-3 font-medium text-muted-foreground">Type</th>
                <th class="pb-3 font-medium text-muted-foreground">Description</th>
              </tr>
            </thead>
            <tbody class="font-mono text-xs">
              <tr>
                <td class="py-3 text-[oklch(0.7_0.18_280)]">trace_id</td>
                <td class="py-3 text-muted-foreground">string</td>
                <td class="py-3 text-foreground font-sans"><strong class="text-primary">Required.</strong> 32-character hex trace ID</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <h4 class="mb-3 text-sm font-medium text-muted-foreground">Example Response</h4>
      <CodeBlock code={GET_TRACE_RESPONSE} lang="json" />
    </section>
  </div>

  <!-- Usage Examples -->
  <div class="mt-16 animate-fade-in" style="animation-delay: 350ms;">
    <h2 class="mb-6 text-sm font-medium uppercase tracking-wider text-muted-foreground">
      Usage Examples
    </h2>

    <div class="space-y-6">
      <!-- Example 1 -->
      <div class="rounded-xl border border-border/50 bg-card/30 p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[oklch(0.7_0.2_25)]/10 text-[oklch(0.7_0.2_25)]">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
              <path d="M12 9v4" />
              <path d="M12 17h.01" />
            </svg>
          </div>
          <h3 class="font-semibold text-foreground">Find Recent Errors</h3>
        </div>
        <p class="mb-4 text-sm text-muted-foreground">
          Ask your agent to find failed LLM calls in the last hour:
        </p>
        <div class="rounded-lg bg-muted/50 p-4">
          <p class="font-mono text-sm text-foreground">
            "Use list_traces with status STATUS_CODE_ERROR and hours=1 to find any failed LLM requests"
          </p>
        </div>
      </div>

      <!-- Example 2 -->
      <div class="rounded-xl border border-border/50 bg-card/30 p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[oklch(0.7_0.18_145)]/10 text-[oklch(0.7_0.18_145)]">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
            </svg>
          </div>
          <h3 class="font-semibold text-foreground">Analyze a Specific Trace</h3>
        </div>
        <p class="mb-4 text-sm text-muted-foreground">
          Get detailed cost and token breakdown for a trace:
        </p>
        <div class="rounded-lg bg-muted/50 p-4">
          <p class="font-mono text-sm text-foreground">
            "Get the trace details for a1b2c3d4... and tell me how many tokens it used and what it cost"
          </p>
        </div>
      </div>

      <!-- Example 3: Workflow -->
      <div class="rounded-xl border border-[oklch(0.7_0.18_280)]/30 bg-[oklch(0.7_0.18_280)]/5 p-6">
        <div class="mb-4 flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[oklch(0.7_0.18_280)]/20 text-[oklch(0.7_0.18_280)]">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            </svg>
          </div>
          <h3 class="font-semibold text-foreground">Debug Workflow</h3>
        </div>
        <p class="mb-4 text-sm text-muted-foreground">
          A typical debugging session using both tools:
        </p>
        <ol class="space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[oklch(0.7_0.18_280)]/20 text-xs font-bold text-[oklch(0.7_0.18_280)]">1</span>
            <span class="text-foreground">
              <strong>list_traces</strong> — Find recent traces, optionally filtering by provider or status
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[oklch(0.7_0.18_280)]/20 text-xs font-bold text-[oklch(0.7_0.18_280)]">2</span>
            <span class="text-foreground">
              <strong>get_trace</strong> — Get detailed spans, timing, tokens, and costs for a specific trace
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[oklch(0.7_0.18_280)]/20 text-xs font-bold text-[oklch(0.7_0.18_280)]">3</span>
            <span class="text-foreground">
              <strong>Analyze</strong> — Your agent can now explain what happened, identify issues, and suggest fixes
            </span>
          </li>
        </ol>
      </div>
    </div>
  </div>

  <!-- Tips -->
  <div class="mt-12 animate-fade-in" style="animation-delay: 400ms;">
    <div class="rounded-xl border border-primary/20 bg-primary/5 p-6">
      <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-primary">
        Tips
      </h3>
      <ul class="space-y-3 text-sm text-foreground">
        <li class="flex items-start gap-3">
          <div class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></div>
          <span>
            <strong>OAuth authentication:</strong> First-time use triggers an OAuth flow. Sign in with your Trace Flow account to authorize the MCP server.
          </span>
        </li>
        <li class="flex items-start gap-3">
          <div class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></div>
          <span>
            <strong>Auto-refresh:</strong> Access tokens refresh automatically. You only need to authenticate once per device.
          </span>
        </li>
        <li class="flex items-start gap-3">
          <div class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></div>
          <span>
            <strong>Filter early:</strong> Use provider, model, or status filters in list_traces to reduce noise and find relevant traces faster.
          </span>
        </li>
        <li class="flex items-start gap-3">
          <div class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></div>
          <span>
            <strong>Pagination:</strong> Results are paginated. Use the cursor from the response to fetch more traces if needed.
          </span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Next Steps -->
  <div class="mt-12 animate-fade-in" style="animation-delay: 450ms;">
    <h2 class="mb-6 text-sm font-medium uppercase tracking-wider text-muted-foreground">
      Next Steps
    </h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/docs/agents" class="group">
        <div class="relative flex h-full flex-col rounded-xl border border-border/50 bg-card/50 p-5 transition-all duration-200 hover:border-primary/30 hover:bg-card">
          <h3 class="mb-1 font-semibold text-foreground">AI Agents</h3>
          <p class="text-sm text-muted-foreground">Gateway integration guide</p>
        </div>
      </a>
      <a href="/docs/quick-start" class="group">
        <div class="relative flex h-full flex-col rounded-xl border border-border/50 bg-card/50 p-5 transition-all duration-200 hover:border-primary/30 hover:bg-card">
          <h3 class="mb-1 font-semibold text-foreground">Quick Start</h3>
          <p class="text-sm text-muted-foreground">Send traces to Trace Flow</p>
        </div>
      </a>
      <a href="/docs/sdk-reference" class="group">
        <div class="relative flex h-full flex-col rounded-xl border border-border/50 bg-card/50 p-5 transition-all duration-200 hover:border-primary/30 hover:bg-card">
          <h3 class="mb-1 font-semibold text-foreground">SDK Reference</h3>
          <p class="text-sm text-muted-foreground">Provider examples</p>
        </div>
      </a>
      <a href="/docs/opentelemetry" class="group">
        <div class="relative flex h-full flex-col rounded-xl border border-border/50 bg-card/50 p-5 transition-all duration-200 hover:border-primary/30 hover:bg-card">
          <h3 class="mb-1 font-semibold text-foreground">OpenTelemetry</h3>
          <p class="text-sm text-muted-foreground">Custom spans and traces</p>
        </div>
      </a>
    </div>
  </div>
</DocsLayout>
