---
import DocsLayout from '@/layouts/DocsLayout.astro';
import agentsContent from '../../../public/agents.md?raw';

const estimatedTokens = Math.ceil(agentsContent.length / 4);
---

<DocsLayout title="AI Agents - Trace Flow Docs">
  <!-- Hero -->
  <div class="mb-16 animate-fade-in">
    <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1">
      <svg class="h-3.5 w-3.5 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 8V4H8" />
        <rect width="16" height="12" x="4" y="8" rx="2" />
        <path d="M2 14h2" />
        <path d="M20 14h2" />
        <path d="M15 13v2" />
        <path d="M9 13v2" />
      </svg>
      <span class="font-mono text-xs text-primary">AI Agents</span>
    </div>
    <h1 class="mb-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
      Bootstrap Your AI Assistant
    </h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      Give Claude Code, Cursor, or any AI assistant instant knowledge of Trace Flow.
      Copy the integration guide into your context or link directly to the file.
    </p>
  </div>

  <!-- How to Use -->
  <div class="mb-12 animate-fade-in" style="animation-delay: 100ms;">
    <h2 class="mb-6 text-sm font-medium uppercase tracking-wider text-muted-foreground">
      How to Use
    </h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Claude Code -->
      <div class="rounded-xl border border-border/50 bg-card/50 p-5">
        <div class="mb-3 flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-[oklch(0.75_0.12_50)]/10 text-[oklch(0.75_0.12_50)]">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M13.827 3.52h3.603L24 20h-3.603l-6.57-16.48zm-7.258 0h3.767L16.906 20h-3.674l-1.343-3.461H5.017l-1.344 3.46H0L6.57 3.522zm3.174 3.662L6.53 13.641h6.441l-3.228-6.46z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-foreground">Claude Code</h3>
        </div>
        <p class="text-sm text-muted-foreground">
          Add to your project's <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">CLAUDE.md</code> file,
          or paste directly when starting a session.
        </p>
      </div>

      <!-- Cursor -->
      <div class="rounded-xl border border-border/50 bg-card/50 p-5">
        <div class="mb-3 flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-[oklch(0.7_0.15_262)]/10 text-[oklch(0.7_0.15_262)]">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m4 4 7.07 17 2.51-7.39L21 11.07z" />
            </svg>
          </div>
          <h3 class="font-semibold text-foreground">Cursor</h3>
        </div>
        <p class="text-sm text-muted-foreground">
          Add to your <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">.cursorrules</code> file,
          or include via <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">@file</code> reference.
        </p>
      </div>

      <!-- Other -->
      <div class="rounded-xl border border-border/50 bg-card/50 p-5">
        <div class="mb-3 flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8V4H8" />
              <rect width="16" height="12" x="4" y="8" rx="2" />
              <path d="M2 14h2" />
              <path d="M20 14h2" />
              <path d="M15 13v2" />
              <path d="M9 13v2" />
            </svg>
          </div>
          <h3 class="font-semibold text-foreground">Any AI Assistant</h3>
        </div>
        <p class="text-sm text-muted-foreground">
          Copy the content below and paste it into your assistant's context window when working with Trace Flow.
        </p>
      </div>
    </div>
  </div>

  <!-- Direct Link -->
  <div class="mb-8 animate-fade-in" style="animation-delay: 150ms;">
    <div class="rounded-xl border border-border/50 bg-card/30 p-5">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h3 class="mb-1 font-medium text-foreground">Direct File Link</h3>
          <p class="text-sm text-muted-foreground">
            Point your assistant to fetch this file directly when needed:
          </p>
        </div>
        <a
          href="/agents.md"
          target="_blank"
          class="inline-flex items-center gap-2 rounded-lg border border-primary/30 bg-primary/10 px-4 py-2 font-mono text-sm text-primary transition-colors hover:bg-primary/20"
        >
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" x2="21" y1="14" y2="3" />
          </svg>
          trace-flow.dev/agents.md
        </a>
      </div>
      <div class="mt-4 rounded-lg bg-muted/30 p-3">
        <p class="font-mono text-xs text-muted-foreground">
          "If you need more information on Trace Flow, fetch https://trace-flow.dev/agents.md"
        </p>
      </div>
    </div>
  </div>

  <!-- Integration Guide Content -->
  <div class="animate-fade-in" style="animation-delay: 200ms;">
    <div class="rounded-xl border border-border/50 bg-card/30">
      <div class="flex items-center justify-between border-b border-border/50 px-5 py-4">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
            <polyline points="14 2 14 8 20 8" />
          </svg>
          <div>
            <h3 class="font-medium text-foreground">agents.md</h3>
            <p class="text-xs text-muted-foreground">~{estimatedTokens} tokens</p>
          </div>
        </div>
        <button
          id="copy-agents-content"
          class="flex items-center gap-2 rounded-lg border border-border/50 bg-background/50 px-4 py-2 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
          <svg class="copy-icon h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
          </svg>
          <svg class="check-icon hidden h-4 w-4 text-[oklch(0.7_0.18_145)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span id="copy-text">Copy to Clipboard</span>
        </button>
      </div>
      <pre id="agents-content" class="max-h-[32rem] overflow-auto p-5 font-mono text-sm leading-relaxed text-foreground/90">{agentsContent}</pre>
    </div>
  </div>

  <!-- Tips -->
  <div class="mt-12 animate-fade-in" style="animation-delay: 250ms;">
    <div class="rounded-xl border border-primary/20 bg-primary/5 p-6">
      <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-primary">
        Tips for AI Assistants
      </h3>
      <ul class="space-y-3 text-sm text-foreground">
        <li class="flex items-start gap-3">
          <div class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></div>
          <span>
            <strong>On-demand loading:</strong> Only include this in context when working on Trace Flow integration.
            Remove it when working on unrelated code to save tokens.
          </span>
        </li>
        <li class="flex items-start gap-3">
          <div class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></div>
          <span>
            <strong>Fetch when needed:</strong> Tell your assistant to fetch the agents.md file when it needs more context,
            rather than always including it.
          </span>
        </li>
        <li class="flex items-start gap-3">
          <div class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></div>
          <span>
            <strong>More documentation:</strong> The agents.md file includes links to detailed docs for advanced topics
            like OpenTelemetry setup and per-provider examples.
          </span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Next Steps -->
  <div class="mt-12 animate-fade-in" style="animation-delay: 300ms;">
    <h2 class="mb-6 text-sm font-medium uppercase tracking-wider text-muted-foreground">
      Full Documentation
    </h2>
    <div class="grid gap-4 sm:grid-cols-3">
      <a href="/docs/quick-start" class="group">
        <div class="relative flex h-full flex-col rounded-xl border border-border/50 bg-card/50 p-5 transition-all duration-200 hover:border-primary/30 hover:bg-card">
          <h3 class="mb-1 font-semibold text-foreground">Quick Start</h3>
          <p class="text-sm text-muted-foreground">Full integration walkthrough</p>
        </div>
      </a>
      <a href="/docs/sdk-reference" class="group">
        <div class="relative flex h-full flex-col rounded-xl border border-border/50 bg-card/50 p-5 transition-all duration-200 hover:border-primary/30 hover:bg-card">
          <h3 class="mb-1 font-semibold text-foreground">SDK Reference</h3>
          <p class="text-sm text-muted-foreground">All provider examples</p>
        </div>
      </a>
      <a href="/docs/opentelemetry" class="group">
        <div class="relative flex h-full flex-col rounded-xl border border-border/50 bg-card/50 p-5 transition-all duration-200 hover:border-primary/30 hover:bg-card">
          <h3 class="mb-1 font-semibold text-foreground">OpenTelemetry</h3>
          <p class="text-sm text-muted-foreground">Advanced tracing setup</p>
        </div>
      </a>
    </div>
  </div>

  <script>
    const copyButton = document.getElementById('copy-agents-content');
    const copyText = document.getElementById('copy-text');
    const content = document.getElementById('agents-content');
    const copyIcon = copyButton?.querySelector('.copy-icon');
    const checkIcon = copyButton?.querySelector('.check-icon');

    copyButton?.addEventListener('click', async () => {
      if (content) {
        await navigator.clipboard.writeText(content.textContent || '');
        if (copyText && copyIcon && checkIcon) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          copyText.textContent = 'Copied!';
          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            copyText.textContent = 'Copy to Clipboard';
          }, 2000);
        }
      }
    });
  </script>
</DocsLayout>
