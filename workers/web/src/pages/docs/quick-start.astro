---
import DocsLayout from '@/layouts/DocsLayout.astro';
import CodeBlock from '@/components/docs/CodeBlock.astro';

const INSTALL_CODE = `npm install ai @ai-sdk/openai`;

const PROVIDER_CODE = `import { createOpenAI } from "@ai-sdk/openai";

const openai = createOpenAI({
  baseURL: "https://gateway.trace-flow.dev/openai/v1",
  apiKey: process.env.OPENAI_API_KEY,
  headers: {
    "X-Trace-Flow-Api-Key": process.env.TRACE_FLOW_API_KEY,
  },
});`;

const LINKED_CODE = `import { trace, context } from "@opentelemetry/api";
import { generateText } from "ai";

// Get the current span context from your tracer
const parentSpan = tracer.startSpan("user-request");
const ctx = parentSpan.spanContext();

// Pass trace context to link this LLM call to your trace
const result = await generateText({
  model: openai("gpt-4o"),
  prompt: userMessage,
  headers: {
    "X-Trace-Flow-Trace-Id": ctx.traceId,
    "X-Trace-Flow-Parent-Span-Id": ctx.spanId,
  },
});

parentSpan.end();`;
---

<DocsLayout title="Quick Start - Trace Flow Docs">
  <!-- Hero -->
  <div class="mb-16 animate-fade-in">
    <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1">
      <svg class="h-3.5 w-3.5 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
      </svg>
      <span class="font-mono text-xs text-primary">Quick Start</span>
    </div>
    <h1 class="mb-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
      See Your Entire LLM Workflow
    </h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      Get full observability in minutes. Trace every step from user input to final response,
      including API calls, LLM requests, tool calls, and agent chains.
    </p>
  </div>

  <!-- Trace Flow Diagram -->
  <div class="mb-16 animate-fade-in" style="animation-delay: 100ms;">
    <div class="rounded-xl border border-border/50 bg-card/30 p-6">
      <h3 class="mb-6 text-sm font-medium uppercase tracking-wider text-muted-foreground">
        What You'll See in Trace Flow
      </h3>
      <div class="flex flex-wrap items-center justify-center gap-3 font-mono text-sm">
        <div class="flex items-center gap-2 rounded-lg border border-primary/30 bg-primary/10 px-3 py-2 text-primary">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          <span>User Event</span>
        </div>
        <svg class="h-4 w-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
        <div class="flex items-center gap-2 rounded-lg border border-[oklch(0.7_0.18_145)]/30 bg-[oklch(0.7_0.18_145)]/10 px-3 py-2 text-[oklch(0.7_0.18_145)]">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 1 1-6.219-8.56" />
          </svg>
          <span>API Call</span>
        </div>
        <svg class="h-4 w-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
        <div class="flex items-center gap-2 rounded-lg border border-[oklch(0.7_0.15_262)]/30 bg-[oklch(0.7_0.15_262)]/10 px-3 py-2 text-[oklch(0.7_0.15_262)]">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8" />
            <rect width="16" height="12" x="4" y="8" rx="2" />
            <path d="M2 14h2" />
            <path d="M20 14h2" />
            <path d="M15 13v2" />
            <path d="M9 13v2" />
          </svg>
          <span>LLM Request</span>
        </div>
        <svg class="h-4 w-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
        <div class="flex items-center gap-2 rounded-lg border border-[oklch(0.75_0.12_50)]/30 bg-[oklch(0.75_0.12_50)]/10 px-3 py-2 text-[oklch(0.75_0.12_50)]">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4" />
          </svg>
          <span>Tool Calls</span>
        </div>
        <svg class="h-4 w-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
        <div class="flex items-center gap-2 rounded-lg border border-[oklch(0.7_0.2_160)]/30 bg-[oklch(0.7_0.2_160)]/10 px-3 py-2 text-[oklch(0.7_0.2_160)]">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span>Response</span>
        </div>
      </div>
      <p class="mt-6 text-center text-sm text-muted-foreground">
        All steps appear as connected spans in your trace view, showing timing, token usage, and request/response bodies.
      </p>
    </div>
  </div>

  <!-- Step 1: Install -->
  <div class="space-y-12">
    <section class="animate-fade-in" style="animation-delay: 150ms;">
      <div class="mb-6 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-lg font-bold text-primary">
          1
        </div>
        <h2 class="text-xl font-semibold tracking-tight text-foreground">Install the SDK</h2>
      </div>
      <p class="mb-4 text-muted-foreground">
        We recommend the Vercel AI SDK for its unified interface across providers. See the
        <a href="/docs/sdk-reference" class="text-primary hover:underline">SDK Reference</a> for other options.
      </p>
      <CodeBlock code={INSTALL_CODE} lang="bash" />
    </section>

    <!-- Get API Key -->
    <section class="animate-fade-in" style="animation-delay: 175ms;">
      <div class="rounded-xl border border-primary/20 bg-primary/5 p-6">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4" />
            </svg>
          </div>
          <div>
            <h3 class="mb-1 font-semibold text-foreground">Get Your API Key</h3>
            <p class="mb-3 text-sm text-muted-foreground">
              Create an API key in the dashboard to authenticate requests through the Trace Flow gateway.
            </p>
            <a href="/app/api-keys" class="inline-flex items-center gap-1 text-sm text-primary hover:underline">
              <span>Create API Key</span>
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Step 2: Configure -->
    <section class="animate-fade-in" style="animation-delay: 200ms;">
      <div class="mb-6 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-lg font-bold text-primary">
          2
        </div>
        <h2 class="text-xl font-semibold tracking-tight text-foreground">Configure Your Provider</h2>
      </div>
      <p class="mb-4 text-muted-foreground">
        Point your provider at the Trace Flow gateway. Add your
        <a href="/app/api-keys" class="text-primary hover:underline">Trace Flow API key</a> in the headers.
      </p>
      <CodeBlock code={PROVIDER_CODE} lang="typescript" />
      <p class="mt-4 text-sm text-muted-foreground">
        That's it for basic usage. LLM requests will now appear in your
        <a href="/app/traces" class="text-primary hover:underline">Traces dashboard</a>.
      </p>
    </section>

    <!-- Step 3: Link to traces -->
    <section class="animate-fade-in" style="animation-delay: 250ms;">
      <div class="mb-6 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-lg font-bold text-primary">
          3
        </div>
        <h2 class="text-xl font-semibold tracking-tight text-foreground">Link to Your Traces</h2>
      </div>
      <div class="mb-6 rounded-lg border border-primary/20 bg-primary/5 p-4">
        <p class="text-sm text-foreground">
          <strong>This is the key integration.</strong> Pass trace context headers to connect LLM calls
          to your existing OpenTelemetry traces. This creates a unified view of your entire workflow.
        </p>
      </div>
      <CodeBlock code={LINKED_CODE} lang="typescript" />
    </section>

    <!-- Headers Reference -->
    <section class="animate-fade-in" style="animation-delay: 300ms;">
      <div class="rounded-xl border border-border/50 bg-card/50 p-6">
        <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-muted-foreground">
          Trace Context Headers
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border/50 text-left">
                <th class="pb-3 font-medium text-muted-foreground">Header</th>
                <th class="pb-3 font-medium text-muted-foreground">Format</th>
                <th class="pb-3 font-medium text-muted-foreground">Purpose</th>
              </tr>
            </thead>
            <tbody class="font-mono text-xs">
              <tr class="border-b border-border/30">
                <td class="py-3 text-primary">X-Trace-Flow-Api-Key</td>
                <td class="py-3 text-muted-foreground">string</td>
                <td class="py-3 text-foreground">Required. Your Trace Flow API key.</td>
              </tr>
              <tr class="border-b border-border/30">
                <td class="py-3 text-primary">X-Trace-Flow-Trace-Id</td>
                <td class="py-3 text-muted-foreground">32 hex chars</td>
                <td class="py-3 text-foreground">Optional. Join an existing trace.</td>
              </tr>
              <tr>
                <td class="py-3 text-primary">X-Trace-Flow-Parent-Span-Id</td>
                <td class="py-3 text-muted-foreground">16 hex chars</td>
                <td class="py-3 text-foreground">Optional. Set the parent span for hierarchy.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <!-- Next Steps -->
  <div class="mt-16 animate-fade-in" style="animation-delay: 350ms;">
    <h2 class="mb-6 text-sm font-medium uppercase tracking-wider text-muted-foreground">
      Next Steps
    </h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <a href="/docs/sdk-reference" class="group">
        <div class="relative flex h-full flex-col rounded-xl border border-border/50 bg-card/50 p-6 transition-all duration-200 hover:border-primary/30 hover:bg-card">
          <div class="absolute -inset-px rounded-xl bg-gradient-to-b from-primary/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
          <div class="relative">
            <h3 class="mb-2 text-lg font-semibold text-foreground">SDK Reference</h3>
            <p class="text-sm text-muted-foreground">
              Examples for OpenAI, Anthropic, OpenRouter, Groq, and native SDKs.
            </p>
          </div>
        </div>
      </a>
      <a href="/docs/opentelemetry" class="group">
        <div class="relative flex h-full flex-col rounded-xl border border-border/50 bg-card/50 p-6 transition-all duration-200 hover:border-primary/30 hover:bg-card">
          <div class="absolute -inset-px rounded-xl bg-gradient-to-b from-primary/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
          <div class="relative">
            <h3 class="mb-2 text-lg font-semibold text-foreground">OpenTelemetry Setup</h3>
            <p class="text-sm text-muted-foreground">
              Set up your own tracer for custom spans, events, and attributes.
            </p>
          </div>
        </div>
      </a>
    </div>
  </div>
</DocsLayout>
