{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": ["datasources/**", "pipes/**"],
  "ignoreBinaries": ["wrangler"],
  "ignoreDependencies": ["cloudflare"],
  "workspaces": {
    "packages/convex": {
      "entry": ["**/*.ts"],
      "project": ["**/*.ts"],
      "ignore": ["_generated/**"]
    },
    "packages/sdk-tests": {
      "entry": ["src/**/*.ts"]
    },
    "apps/proxy": {
      "ignoreDependencies": ["@vitest/coverage-v8"]
    },
    "apps/proxy-consumer": {
      "ignoreDependencies": ["@vitest/coverage-v8"]
    },
    "apps/web": {
      "entry": ["src/worker-entry.ts", "open-next.config.ts"],
      "ignoreDependencies": ["postcss"]
    }
  }
}
