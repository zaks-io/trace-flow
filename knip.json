{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "scripts/**",
    ".agents/skills/**",
    ".claude/skills/**",
    ".claude/.agents/skills/**",
    "apps/desktop/ui/**",
    "tests/tinybird-jwt-allowlist.test.ts"
  ],
  "ignoreBinaries": ["wrangler", "tb"],
  "ignoreDependencies": ["cloudflare"],
  "workspaces": {
    "packages/convex": {
      "entry": ["**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/sdk-tests": {
      "entry": ["src/**/*.ts"]
    },
    "apps/proxy": {},
    "apps/proxy-consumer": {},
    "apps/web": {
      "entry": ["open-next.config.ts"],
      "ignoreDependencies": ["postcss"],
      "ignoreUnresolved": ["@/generated/*"]
    }
  }
}
