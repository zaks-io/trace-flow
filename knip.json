{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": ["scripts/**", ".agents/skills/**", ".claude/skills/**", "apps/desktop/ui/**"],
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignoreBinaries": ["wrangler", "tb"],
  "ignoreDependencies": ["cloudflare"],
  "workspaces": {
    "packages/convex": {
      "entry": ["**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/sdk-tests": {
      "entry": ["src/**/*.ts"]
    },
    "apps/analyst-sandbox": {
      "entry": ["python-tests/generate-client.mts"]
    },
    "apps/proxy": {},
    "apps/proxy-consumer": {},
    "apps/archive-api": {
      "ignoreDependencies": ["wrangler"]
    },
    "apps/web": {
      "entry": ["open-next.config.ts"],
      "ignoreDependencies": ["postcss"],
      "ignoreUnresolved": ["@/generated/*"]
    }
  }
}
