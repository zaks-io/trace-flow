{
  "name": "trace-flow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:all": "wrangler dev -c apps/proxy/wrangler.toml -c apps/proxy-consumer/wrangler.toml -c apps/api/wrangler.toml --persist-to .wrangler/state",
    "dev:web": "bun run --filter @trace-flow/web dev",
    "deploy:dev": "turbo run deploy:dev --filter='./apps/*'",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" && turbo run lint type-check test build",
    "knip": "knip",
    "prepare": "husky"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260413.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "convex": "^1.35.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "prettier": "^3.8.2",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
