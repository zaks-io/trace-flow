{
  "name": "trace-flow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build --concurrency=2",
    "dev": "turbo run dev",
    "dev:doctor": "bash scripts/dev/local-stack.sh doctor",
    "dev:install": "bash scripts/dev/local-stack.sh install",
    "dev:seed": "bash scripts/dev/local-stack.sh seed",
    "dev:setup": "bash scripts/dev/local-stack.sh up",
    "dev:smoke": "bash scripts/dev/local-stack.sh smoke",
    "dev:all": "bash scripts/dev/workers.sh",
    "dev:web": "bun run --filter @trace-flow/web dev",
    "dev:verify": "bash scripts/dev/local-stack.sh verify",
    "deploy:dev": "turbo run deploy:dev --filter='./apps/*'",
    "lint": "turbo run lint --concurrency=2",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "turbo run type-check --concurrency=2",
    "test": "turbo run test --concurrency=2",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage --concurrency=2",
    "test:tinybird": "bun run tinybird:contract && tb --local build && bash scripts/ci/run-tinybird-local-fixture-tests.sh",
    "tinybird:contract": "bash scripts/verify-tinybird-cost-contract.sh && node scripts/verify-agent-signal-query-guardrails.mjs && node scripts/verify-agent-snapshot-contract.mjs",
    "tinybird:perf": "bash scripts/tinybird-performance-report.sh",
    "tinybird:agent-signal:perf": "bash scripts/tinybird-agent-signal-performance-report.sh",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" && turbo run lint type-check test build --concurrency=2 --summarize",
    "ci:check": "bash scripts/ci-check.sh",
    "duplicates:check": "jscpd --config .jscpd.json apps packages scripts",
    "knip": "knip",
    "prepare": "node scripts/dev/prepare-hooks.mjs"
  },
  "overrides": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "convex": "1.44.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jscpd": "^4.3.0",
    "knip": "^5.88.1",
    "prettier": "3.8.3",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "license": "Apache-2.0",
  "patchedDependencies": {
    "@sentry/cloudflare@10.73.0": "patches/@sentry%2Fcloudflare@10.73.0.patch"
  }
}
