DESCRIPTION >
    List traces with offset-based pagination for MCP tools.
    Returns formatted fields ready for API response.
    The api_keys parameter is enforced via JWT fixed_params for security.

NODE endpoint
SQL >
    %
    SELECT
        TraceId as trace_id,
        formatDateTime(toDateTime(ReceivedAt / 1000000000), '%Y-%m-%dT%H:%i:%S') || '.' ||
            lpad(toString(toInt64(ReceivedAt / 1000000) % 1000), 3, '0') || 'Z' as timestamp,
        Duration / 1000000 as duration_ms,
        if(StatusCode = 'STATUS_CODE_OK', 'ok', 'error') as status,
        JSONExtractString(SpanAttributes, 'gen_ai.system') as provider,
        JSONExtractString(SpanAttributes, 'gen_ai.request.model') as model,
        JSONExtractInt(SpanAttributes, 'gen_ai.usage.input_tokens') as prompt_tokens,
        JSONExtractInt(SpanAttributes, 'gen_ai.usage.output_tokens') as completion_tokens,
        JSONExtractInt(SpanAttributes, 'gen_ai.usage.input_tokens') + JSONExtractInt(SpanAttributes, 'gen_ai.usage.output_tokens') as total_tokens,
        JSONExtractFloat(SpanAttributes, 'gen_ai.cost.total') as cost_usd,
        count(*) OVER() as total_count
    FROM otel_traces
    WHERE JSONExtractString(SpanAttributes, 'trace_flow.source') = 'proxy'
        AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        AND ReceivedAt >= {{ Int64(start_time_ns, 0) }}
        {% if defined(provider) %}
        AND JSONExtractString(SpanAttributes, 'gen_ai.system') = {{ String(provider) }}
        {% end %}
        {% if defined(model) %}
        AND JSONExtractString(SpanAttributes, 'gen_ai.request.model') = {{ String(model) }}
        {% end %}
        {% if defined(status) %}
        AND StatusCode = {{ String(status) }}
        {% end %}
    ORDER BY
        {% if defined(sort_by) and sort_by == 'duration_ms' %}
        duration_ms
        {% elif defined(sort_by) and sort_by == 'cost_usd' %}
        cost_usd
        {% elif defined(sort_by) and sort_by == 'tokens' %}
        total_tokens
        {% else %}
        ReceivedAt
        {% end %}
        {% if defined(order) and order == 'asc' %}ASC{% else %}DESC{% end %}
    LIMIT {{ Int32(limit, 10) }}
    OFFSET {{ Int32(offset, 0) }}

TYPE ENDPOINT
