DESCRIPTION >
    Get all spans for a specific trace, filtered by API keys.
    Supports delta fetching via optional since_timestamp parameter.
    The api_keys parameter is enforced via JWT fixed_params for security.

NODE endpoint
SQL >
    %
    SELECT
        ReceivedAt,
        Timestamp,
        TraceId,
        SpanId,
        ParentSpanId,
        SpanName,
        SpanKind,
        ServiceName,
        Duration,
        StatusCode,
        StatusMessage,
        SpanAttributes,
        ResourceAttributes,
        `Events.Timestamp`,
        `Events.Name`,
        `Events.Attributes`
    FROM otel_trace_spans
    WHERE TraceId = {{ String(trace_id, '') }}
        AND (
            ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
            OR has(arrayMap(key_identifier -> if(match(key_identifier, '^sha256:[0-9a-f]{64}$'), key_identifier, concat('sha256:', lower(hex(SHA256(key_identifier))))), splitByChar(',', {{ String(api_keys, '') }})), if(match(ApiKey, '^sha256:[0-9a-f]{64}$'), ApiKey, concat('sha256:', lower(hex(SHA256(ApiKey))))))
        )
        AND ReceivedAt >= toInt64(toUnixTimestamp(now() - toIntervalDay({{ Int32(retention_days, 7) }}))) * 1000000000
        {% if defined(since_timestamp) %}
        AND Timestamp > {{ Int64(since_timestamp) }}
        {% end %}
    ORDER BY Timestamp ASC

TYPE ENDPOINT
