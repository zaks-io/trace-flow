DESCRIPTION >
    Detect unapproved provider/model pairs and priced-model gaps over llm_request_facts.
    The api_keys parameter is enforced by the caller's org/API-key scope.

NODE anomalies
SQL >
    %
    WITH
        {{ Int64(start_time_ns, 0) }} AS start_ns_raw,
        if(start_ns_raw = 0, toUnixTimestamp64Nano(toDateTime64(now() - toIntervalDay(1), 9)), start_ns_raw) AS start_ns,
        {{ Int64(end_time_ns, 0) }} AS end_ns_raw,
        if(end_ns_raw = 0, toUnixTimestamp64Nano(toDateTime64(now(), 9)), end_ns_raw) AS end_ns,
        arrayFilter(key -> key != '', splitByChar(',', {{ String(approved_provider_models, '') }})) AS approved_pair_keys,
        arrayFilter(key -> key != '', splitByChar(',', {{ String(zero_cost_provider_models, '') }})) AS zero_cost_pair_keys
    SELECT
        Provider AS provider,
        Model AS model,
        count() AS request_count,
        sum(TokenCount) AS token_count,
        sum(TotalCostMicrodollars) / 1000000 AS total_cost_usd,
        countIf(IsUnapproved) AS unapproved_request_count,
        countIf(IsUnpriced) AS unpriced_request_count,
        min(ReceivedAt) AS first_seen_ns,
        max(ReceivedAt) AS last_seen_ns,
        argMax(TraceId, (ReceivedAt, TraceId, SpanId)) AS sample_trace_id,
        argMax(SpanId, (ReceivedAt, TraceId, SpanId)) AS sample_span_id
    FROM (
        SELECT
            ReceivedAt,
            TraceId,
            SpanId,
            Provider,
            Model,
            TotalCostMicrodollars,
            greatest(InputTokens, UncachedInputTokens + CacheReadInputTokens + CacheCreationInputTokens)
                + OutputTokens
                + ReasoningTokens AS TokenCount,
            lowerUTF8(Provider) AS ProviderKey,
            lowerUTF8(Model) AS ModelKey,
            lower(hex(SHA256(concat(
                toString(length(ProviderKey)),
                ':',
                ProviderKey,
                toString(length(ModelKey)),
                ':',
                ModelKey
            )))) AS ProviderModelPairKey,
            NOT has(approved_pair_keys, ProviderModelPairKey) AS IsUnapproved,
            (
                TokenCount > 0
                AND TotalCostMicrodollars = 0
                AND NOT has(zero_cost_pair_keys, ProviderModelPairKey)
            ) AS IsUnpriced
        FROM llm_request_facts
        WHERE ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
            AND ReceivedAt >= start_ns
            AND ReceivedAt < end_ns
            AND ReceivedAt >= toInt64(toUnixTimestamp(now() - toIntervalDay({{ Int32(retention_days, 7) }}))) * 1000000000
            {% if defined(provider) %}
            AND Provider = {{ String(provider) }}
            {% end %}
            {% if defined(model) %}
            AND Model = {{ String(model) }}
            {% end %}
            {% if defined(baggage_operation) %}
            AND BaggageOperation = {{ String(baggage_operation) }}
            {% end %}
            {% if defined(baggage_user_id) %}
            AND BaggageUserId = {{ String(baggage_user_id) }}
            {% end %}
            {% if defined(api_key_filter) %}
            AND ApiKey = {{ String(api_key_filter) }}
            {% end %}
    )
    WHERE IsUnapproved OR IsUnpriced
    GROUP BY Provider, Model
    ORDER BY unapproved_request_count DESC, unpriced_request_count DESC, request_count DESC, provider, model
    LIMIT 20

NODE endpoint
SQL >
    SELECT * FROM anomalies

TYPE ENDPOINT
