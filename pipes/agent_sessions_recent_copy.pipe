DESCRIPTION >
    On-demand affected-session repair for the agent_sessions aggregate. The copy finds
    sessions touched by the recent EventAt window, rebuilds those sessions from base
    FINAL via the canonical agent_priced_usage view, and appends replacement rows.
    agent_sessions uses ReplacingMergeTree(IngestedAt), so the newest row wins for the
    same (OrgId, session_pk). The daily agent_sessions_copy full replace removes any
    stale rows that disappear entirely after source dedupe or parser fixes.

NODE affected_sessions
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms,
        {{ Int64(end_time_ms, 0) }} AS end_ms,
        {{ Int32(rebuild_hours, 72) }} AS rebuild_hours,
        toDateTime64(now(), 3) AS rebuilt_at,
        if(end_ms = 0, rebuilt_at, fromUnixTimestamp64Milli(end_ms)) AS rebuild_end_dt,
        if(start_ms = 0, rebuild_end_dt - toIntervalHour(rebuild_hours), fromUnixTimestamp64Milli(start_ms)) AS rebuild_start_dt
    SELECT DISTINCT OrgId, session_pk
    FROM (
        SELECT OrgId, session_pk
        FROM agent_messages FINAL
        WHERE EventAt >= rebuild_start_dt AND EventAt < rebuild_end_dt

        UNION ALL

        SELECT OrgId, session_pk
        FROM agent_tool_events FINAL
        WHERE EventAt >= rebuild_start_dt AND EventAt < rebuild_end_dt

        UNION ALL

        SELECT OrgId, session_pk
        FROM agent_file_events FINAL
        WHERE EventAt >= rebuild_start_dt AND EventAt < rebuild_end_dt

        UNION ALL

        SELECT OrgId, session_pk
        FROM agent_pull_request_links FINAL
        WHERE EventAt >= rebuild_start_dt AND EventAt < rebuild_end_dt
    )

NODE session_usage
SQL >
    SELECT
        OrgId,
        session_pk,
        argMaxIf(source, EventAt, usage_kind = 'direct') AS source,
        argMaxIf(UserId, EventAt, usage_kind = 'direct') AS UserId,
        argMaxIf(CollectorId, EventAt, usage_kind = 'direct') AS CollectorId,
        argMaxIf(CollectorCredentialId, EventAt, usage_kind = 'direct') AS CollectorCredentialId,
        argMaxIf(repo_fingerprint, EventAt, usage_kind = 'direct') AS repo_fingerprint,
        argMaxIf(repo_source, EventAt, usage_kind = 'direct') AS repo_source,
        argMaxIf(model, EventAt, usage_kind = 'direct') AS model,
        argMaxIf(parser_version, EventAt, usage_kind = 'direct') AS parser_version,
        min(EventAt) AS StartedAt,
        max(EventAt) AS LastEventAt,
        maxIf(VendorStartedAt, usage_kind = 'direct') AS VendorStartedAt,
        max(IngestedAt) AS IngestedAt,
        argMaxIf(git_branch, EventAt, usage_kind = 'direct') AS git_branch,
        argMaxIf(git_head_sha, EventAt, usage_kind = 'direct') AS git_head_sha,
        countIf(usage_kind = 'direct') AS message_count,
        sum(input_tokens) AS input_tokens,
        sum(output_tokens) AS output_tokens,
        sum(cache_read_tokens) AS cache_read_tokens,
        sum(cache_creation_tokens) AS cache_creation_tokens,
        sum(reasoning_tokens) AS reasoning_tokens,
        multiIf(
            countIf(usage_kind = 'direct' AND token_coverage = 'missing') > 0, 'missing',
            countIf(usage_kind = 'direct' AND token_coverage = 'partial') > 0, 'partial',
            'full') AS token_coverage,
        if(countIf(usage_kind = 'direct' AND cache_coverage = 'missing') > 0, 'missing', 'full') AS cache_coverage,
        if(
            countIf(cost_usd IS NOT NULL) = 0,
            CAST(NULL AS Nullable(Float64)),
            CAST(sum(ifNull(cost_usd, 0.)) AS Nullable(Float64))
        ) AS cost_usd
    FROM agent_priced_usage AS u
    INNER JOIN affected_sessions AS a USING (OrgId, session_pk)
    GROUP BY OrgId, session_pk

NODE session_tools
SQL >
    SELECT
        OrgId,
        session_pk,
        toUInt32(count()) AS tool_event_count,
        toUInt32(countIf(status = 'failure')) AS failure_count
    FROM agent_tool_events FINAL
    INNER JOIN affected_sessions AS a USING (OrgId, session_pk)
    GROUP BY OrgId, session_pk

NODE session_files
SQL >
    SELECT
        OrgId,
        session_pk,
        toUInt32(count()) AS file_event_count
    FROM agent_file_events FINAL
    INNER JOIN affected_sessions AS a USING (OrgId, session_pk)
    GROUP BY OrgId, session_pk

NODE session_prs
SQL >
    SELECT
        OrgId,
        session_pk,
        if(uniqExact(url) = 1, any(url), '') AS primary_pull_request_url
    FROM agent_pull_request_links FINAL
    INNER JOIN affected_sessions AS a USING (OrgId, session_pk)
    WHERE url != ''
    GROUP BY OrgId, session_pk

NODE assemble
SQL >
    WITH toDateTime64(now(), 3) AS rebuilt_at
    SELECT
        u.OrgId AS OrgId,
        u.session_pk AS session_pk,
        u.source AS source,
        u.UserId AS UserId,
        u.CollectorId AS CollectorId,
        u.CollectorCredentialId AS CollectorCredentialId,
        u.repo_fingerprint AS repo_fingerprint,
        u.repo_source AS repo_source,
        u.model AS model,
        u.parser_version AS parser_version,
        u.StartedAt AS StartedAt,
        u.LastEventAt AS LastEventAt,
        u.VendorStartedAt AS VendorStartedAt,
        rebuilt_at AS IngestedAt,
        u.git_branch AS git_branch,
        u.git_head_sha AS git_head_sha,
        ifNull(p.primary_pull_request_url, '') AS primary_pull_request_url,
        toUInt32(u.message_count) AS message_count,
        toUInt32(ifNull(t.tool_event_count, 0)) AS tool_event_count,
        toUInt32(ifNull(f.file_event_count, 0)) AS file_event_count,
        toUInt32(ifNull(t.failure_count, 0)) AS failure_count,
        u.input_tokens AS input_tokens,
        u.output_tokens AS output_tokens,
        u.cache_read_tokens AS cache_read_tokens,
        u.cache_creation_tokens AS cache_creation_tokens,
        u.reasoning_tokens AS reasoning_tokens,
        u.token_coverage AS token_coverage,
        u.cache_coverage AS cache_coverage,
        toUInt64(toInt64(toUnixTimestamp64Milli(u.LastEventAt) - toUnixTimestamp64Milli(u.StartedAt))) AS duration_ms,
        u.cost_usd AS cost_usd
    FROM session_usage AS u
    LEFT JOIN session_tools AS t USING (OrgId, session_pk)
    LEFT JOIN session_files AS f USING (OrgId, session_pk)
    LEFT JOIN session_prs AS p USING (OrgId, session_pk)

TYPE COPY
TARGET_DATASOURCE agent_sessions
COPY_MODE append
