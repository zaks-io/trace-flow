DESCRIPTION >
    Time series of LLM usage and cost metrics for a time range.
    Uses hourly, daily, or monthly rollups based on range length.
    The api_keys parameter is enforced via JWT fixed_params for security.

NODE endpoint
SQL >
    %
    WITH
        {{ Int64(start_time_ns, 0) }} AS start_ns,
        {{ Int64(end_time_ns, 0) }} AS end_ns_raw,
        if(end_ns_raw = 0, toUnixTimestamp64Nano(toDateTime64(now(), 9)), end_ns_raw) AS end_ns,
        toDateTime(start_ns / 1000000000) AS start_dt,
        toDateTime(end_ns / 1000000000) AS end_dt,
        dateDiff('day', start_dt, end_dt) AS range_days
    SELECT
        bucket_start,
        countMerge(RequestCount) AS request_count,
        sumMerge(InputTokens) AS input_tokens,
        sumMerge(OutputTokens) AS output_tokens,
        sumMerge(CacheReadInputTokens) AS cache_read_input_tokens,
        sumMerge(CacheCreationInputTokens) AS cache_creation_input_tokens,
        sumMerge(ReasoningTokens) AS reasoning_tokens,
        sumMerge(TotalCostMicrodollars) / 1000000 AS total_cost_usd,
        sumMerge(InputCostMicrodollars) / 1000000 AS input_cost_usd,
        sumMerge(OutputCostMicrodollars) / 1000000 AS output_cost_usd,
        sumMerge(CacheReadCostMicrodollars) / 1000000 AS cache_read_cost_usd,
        sumMerge(CacheCreationCostMicrodollars) / 1000000 AS cache_creation_cost_usd,
        sumMerge(ReasoningCostMicrodollars) / 1000000 AS reasoning_cost_usd,
        sumMerge(InputTokens) + sumMerge(OutputTokens) AS total_tokens,
        greatest(sumMerge(InputTokens) - sumMerge(CacheReadInputTokens), 0) AS new_input_tokens,
        avgMerge(AvgDurationNano) / 1000000 AS avg_duration_ms,
        maxMerge(MaxDurationNano) / 1000000 AS max_duration_ms,
        quantileMerge(0.95)(P95DurationNano) / 1000000 AS p95_duration_ms
    FROM (
        SELECT
            BucketStart AS bucket_start,
            RequestCount,
            InputTokens,
            OutputTokens,
            CacheReadInputTokens,
            CacheCreationInputTokens,
            ReasoningTokens,
            TotalCostMicrodollars,
            InputCostMicrodollars,
            OutputCostMicrodollars,
            CacheReadCostMicrodollars,
            CacheCreationCostMicrodollars,
            ReasoningCostMicrodollars,
            AvgDurationNano,
            MaxDurationNano,
            P95DurationNano
        FROM llm_usage_1h
        WHERE range_days <= 30
            AND BucketStart >= start_dt
            AND BucketStart <= end_dt
            AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
            {% if defined(provider) %}
            AND Provider = {{ String(provider) }}
            {% end %}
            {% if defined(model) %}
            AND Model = {{ String(model) }}
            {% end %}
            {% if defined(operation_name) %}
            AND OperationName = {{ String(operation_name) }}
            {% end %}
            {% if defined(baggage_operation) %}
            AND BaggageOperation = {{ String(baggage_operation) }}
            {% end %}
            {% if defined(status) %}
            AND StatusCode = {{ String(status) }}
            {% end %}
            {% if defined(api_key_filter) %}
            AND ApiKey = {{ String(api_key_filter) }}
            {% end %}
        UNION ALL
        SELECT
            BucketStart AS bucket_start,
            RequestCount,
            InputTokens,
            OutputTokens,
            CacheReadInputTokens,
            CacheCreationInputTokens,
            ReasoningTokens,
            TotalCostMicrodollars,
            InputCostMicrodollars,
            OutputCostMicrodollars,
            CacheReadCostMicrodollars,
            CacheCreationCostMicrodollars,
            ReasoningCostMicrodollars,
            AvgDurationNano,
            MaxDurationNano,
            P95DurationNano
        FROM llm_usage_1d
        WHERE range_days > 30
            AND range_days <= 180
            AND BucketStart >= start_dt
            AND BucketStart <= end_dt
            AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
            {% if defined(provider) %}
            AND Provider = {{ String(provider) }}
            {% end %}
            {% if defined(model) %}
            AND Model = {{ String(model) }}
            {% end %}
            {% if defined(operation_name) %}
            AND OperationName = {{ String(operation_name) }}
            {% end %}
            {% if defined(baggage_operation) %}
            AND BaggageOperation = {{ String(baggage_operation) }}
            {% end %}
            {% if defined(status) %}
            AND StatusCode = {{ String(status) }}
            {% end %}
            {% if defined(api_key_filter) %}
            AND ApiKey = {{ String(api_key_filter) }}
            {% end %}
        UNION ALL
        SELECT
            BucketStart AS bucket_start,
            RequestCount,
            InputTokens,
            OutputTokens,
            CacheReadInputTokens,
            CacheCreationInputTokens,
            ReasoningTokens,
            TotalCostMicrodollars,
            InputCostMicrodollars,
            OutputCostMicrodollars,
            CacheReadCostMicrodollars,
            CacheCreationCostMicrodollars,
            ReasoningCostMicrodollars,
            AvgDurationNano,
            MaxDurationNano,
            P95DurationNano
        FROM llm_usage_1mo
        WHERE range_days > 180
            AND BucketStart >= start_dt
            AND BucketStart <= end_dt
            AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
            {% if defined(provider) %}
            AND Provider = {{ String(provider) }}
            {% end %}
            {% if defined(model) %}
            AND Model = {{ String(model) }}
            {% end %}
            {% if defined(operation_name) %}
            AND OperationName = {{ String(operation_name) }}
            {% end %}
            {% if defined(baggage_operation) %}
            AND BaggageOperation = {{ String(baggage_operation) }}
            {% end %}
            {% if defined(status) %}
            AND StatusCode = {{ String(status) }}
            {% end %}
            {% if defined(api_key_filter) %}
            AND ApiKey = {{ String(api_key_filter) }}
            {% end %}
    )
    GROUP BY bucket_start
    ORDER BY bucket_start ASC

TYPE ENDPOINT
