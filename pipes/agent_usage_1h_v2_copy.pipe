DESCRIPTION >
    Rolling hourly replacement snapshots for Agent usage. The copy replaces the target
    with rebuilt bucket rows for the recent window, so stale bucket/dimension rows are
    removed when base facts dedupe or dimensions heal. Parameters allow an explicit
    repair window; scheduled runs default to the last 72 hours with the
    lower bound snapped to the hour, so the first included bucket is complete.

NODE rollup
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms,
        {{ Int64(end_time_ms, 0) }} AS end_ms,
        {{ Int32(rebuild_hours, 72) }} AS rebuild_hours,
        toDateTime64(now(), 3) AS rebuilt_at,
        if(end_ms = 0, rebuilt_at, fromUnixTimestamp64Milli(end_ms)) AS rebuild_end_dt,
        toStartOfHour(if(start_ms = 0, rebuild_end_dt - toIntervalHour(rebuild_hours), fromUnixTimestamp64Milli(start_ms))) AS rebuild_start_dt
    SELECT
        toStartOfHour(toDateTime(EventAt)) AS BucketStart,
        OrgId,
        source,
        model,
        repo_fingerprint,
        toUInt64(count()) AS MessageCount,
        uniqState(session_pk) AS SessionCount,
        sum(input_tokens) AS InputTokens,
        sum(output_tokens) AS OutputTokens,
        sum(cache_read_tokens) AS CacheReadTokens,
        sum(cache_creation_tokens) AS CacheCreationTokens,
        sum(reasoning_tokens) AS ReasoningTokens,
        sum(toUInt64(cost_usd IS NOT NULL)) AS PricedMessageCount,
        sum(ifNull(cost_usd, 0.)) AS CostUsd,
        rebuilt_at AS RebuiltAt
    FROM agent_priced_usage
    WHERE usage_kind = 'direct'
        AND EventAt >= rebuild_start_dt
        AND EventAt < rebuild_end_dt
    GROUP BY BucketStart, OrgId, source, model, repo_fingerprint

TYPE COPY
TARGET_DATASOURCE agent_usage_1h_v2
COPY_SCHEDULE */15 * * * *
COPY_MODE replace
