DESCRIPTION >
    Get distinct filter options (providers, models, statuses) for the requests table.
    Uses otel_traces_genai materialized view for efficient distinct value lookups.
    The api_keys parameter is enforced via JWT fixed_params for security.

NODE providers
SQL >
    %
    SELECT DISTINCT Provider as value
    FROM otel_traces_genai
    WHERE ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        AND ReceivedAt >= toInt64(toUnixTimestamp(now() - toIntervalDay({{ Int32(retention_days, 7) }}))) * 1000000000
        AND Provider != ''
    ORDER BY value
    LIMIT 100

NODE models
SQL >
    %
    SELECT DISTINCT Model as value
    FROM otel_traces_genai
    WHERE ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        AND ReceivedAt >= toInt64(toUnixTimestamp(now() - toIntervalDay({{ Int32(retention_days, 7) }}))) * 1000000000
        AND Model != ''
    ORDER BY value
    LIMIT 100

NODE statuses
SQL >
    %
    SELECT DISTINCT StatusCode as value
    FROM otel_traces_genai
    WHERE ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        AND ReceivedAt >= toInt64(toUnixTimestamp(now() - toIntervalDay({{ Int32(retention_days, 7) }}))) * 1000000000
    ORDER BY value

NODE operations
SQL >
    %
    SELECT DISTINCT BaggageOperation as value
    FROM otel_traces_genai
    WHERE ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        AND ReceivedAt >= toInt64(toUnixTimestamp(now() - toIntervalDay({{ Int32(retention_days, 7) }}))) * 1000000000
        AND BaggageOperation != ''
    ORDER BY value
    LIMIT 100

NODE endpoint
SQL >
    %
    SELECT
        (SELECT groupArray(value) FROM providers) as providers,
        (SELECT groupArray(value) FROM models) as models,
        (SELECT groupArray(value) FROM statuses) as statuses,
        (SELECT groupArray(value) FROM operations) as operations

TYPE ENDPOINT
