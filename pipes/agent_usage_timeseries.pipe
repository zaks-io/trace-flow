DESCRIPTION >
    Hero time-series for the Agent usage explorer: one bucketed row per period (and per
    group value when group_by is set) with the metrics the chart's switcher needs —
    estimated Agent Session Authoring Cost, token components, message/session counts, and
    Tool Event outcomes. The granularity param controls bucket size: 'auto' (default)
    picks hourly buckets for windows <= 30 days and daily beyond that; 'hour' forces
    hourly (reads agent_usage_1h_v2 / agent_tool_usage_1h_v2 even on > 30d windows);
    'day' forces daily (reads agent_usage_1d_v2 / agent_tool_usage_1d_v2 even on <= 30d windows).
    Both the usage and tool series resolve the same use_daily from shared params, so
    their buckets align in the endpoint join.

    group_by (none/source/model) splits the series by a rollup dimension. group_value is
    '' when group_by=none, else the source or model. Tool Events carry source but no model,
    so when group_by=model their group_value stays '' (the model split is a usage-only
    dimension); the UI keeps Model grouping off the tool-events metric.

    Filters: sources and models are optional comma-separated IN-lists (multi-select). models
    only applies to the usage branches (Tool Events have no model), so a model filter scopes
    cost/tokens/messages/sessions but leaves the tool-events series unfiltered.

    Lambda: replacement snapshots + base fallback. Reads agent_usage_*_v2 and
    agent_tool_usage_*_v2 for buckets inside each snapshot window
    [min(BucketStart), max(BucketStart)), and reads base FINAL rows for older history and
    the live tail. A stale, partial, empty, or warming snapshot table can never hide data.

    Cost is a single estimated figure (the agent data model carries one cost_usd per
    Agent Message, not provider-style per-component cost). cost_usd sums priced rows only;
    priced_message_count / message_count give the priced-token coverage the UI shows beside
    the estimate (ADR "Honesty about cost"). org_id and retention_days are enforced via the
    JWT fixed_params.

NODE usage_series
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms,
        {{ Int64(end_time_ms, 0) }} AS end_ms,
        if(end_ms = 0, toDateTime64(now(), 3), fromUnixTimestamp64Milli(end_ms)) AS end_dt,
        if(start_ms = 0, end_dt - toIntervalDay(7), fromUnixTimestamp64Milli(start_ms)) AS start_dt,
        dateDiff('day', start_dt, end_dt) AS range_days,
        {{ String(granularity, 'auto') }} AS granularity,
        (granularity = 'day' OR (granularity = 'auto' AND range_days > 30)) AS use_daily,
        (SELECT min(BucketStart) FROM agent_usage_1h_v2 WHERE OrgId = {{ String(org_id, '') }}) AS wm_h_min,
        (SELECT max(BucketStart) FROM agent_usage_1h_v2 WHERE OrgId = {{ String(org_id, '') }}) AS wm_h,
        (SELECT min(BucketStart) FROM agent_usage_1d_v2 WHERE OrgId = {{ String(org_id, '') }}) AS wm_d_min,
        (SELECT max(BucketStart) FROM agent_usage_1d_v2 WHERE OrgId = {{ String(org_id, '') }}) AS wm_d
    SELECT
        bucket_dt,
        group_value,
        message_count,
        session_count,
        input_tokens,
        output_tokens,
        cache_read_tokens,
        cache_creation_tokens,
        reasoning_tokens,
        input_tokens + output_tokens + cache_read_tokens
            + cache_creation_tokens + reasoning_tokens AS total_tokens,
        cost_usd,
        priced_message_count
    FROM (
        SELECT
            BucketStart AS bucket_dt,
            multiIf({{ String(group_by, 'none') }} = 'source', toString(source), {{ String(group_by, 'none') }} = 'model', toString(model), {{ String(group_by, 'none') }} = 'repo', toString(repo_fingerprint), '') AS group_value,
            sum(MessageCount) AS message_count,
            uniqMerge(SessionCount) AS session_count,
            sum(InputTokens) AS input_tokens,
            sum(OutputTokens) AS output_tokens,
            sum(CacheReadTokens) AS cache_read_tokens,
            sum(CacheCreationTokens) AS cache_creation_tokens,
            sum(ReasoningTokens) AS reasoning_tokens,
            round(sum(CostUsd), 6) AS cost_usd,
            sum(PricedMessageCount) AS priced_message_count
        FROM agent_usage_1h_v2
        WHERE NOT use_daily
            AND BucketStart >= wm_h_min
            AND BucketStart < wm_h
            AND OrgId = {{ String(org_id, '') }}
            AND BucketStart >= start_dt
            AND BucketStart < end_dt
            AND BucketStart >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
            {% if defined(sources) %}
            AND source IN splitByChar(',', {{ String(sources) }})
            {% end %}
            {% if defined(repos) %}
            AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
            {% end %}
            {% if defined(models) %}
            AND model IN splitByChar(',', {{ String(models) }})
            {% end %}
        GROUP BY bucket_dt, group_value

        UNION ALL

        SELECT
            BucketStart AS bucket_dt,
            multiIf({{ String(group_by, 'none') }} = 'source', toString(source), {{ String(group_by, 'none') }} = 'model', toString(model), {{ String(group_by, 'none') }} = 'repo', toString(repo_fingerprint), '') AS group_value,
            sum(MessageCount) AS message_count,
            uniqMerge(SessionCount) AS session_count,
            sum(InputTokens) AS input_tokens,
            sum(OutputTokens) AS output_tokens,
            sum(CacheReadTokens) AS cache_read_tokens,
            sum(CacheCreationTokens) AS cache_creation_tokens,
            sum(ReasoningTokens) AS reasoning_tokens,
            round(sum(CostUsd), 6) AS cost_usd,
            sum(PricedMessageCount) AS priced_message_count
        FROM agent_usage_1d_v2
        WHERE use_daily
            AND BucketStart >= wm_d_min
            AND BucketStart < wm_d
            AND OrgId = {{ String(org_id, '') }}
            AND BucketStart >= start_dt
            AND BucketStart < end_dt
            AND BucketStart >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
            {% if defined(sources) %}
            AND source IN splitByChar(',', {{ String(sources) }})
            {% end %}
            {% if defined(repos) %}
            AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
            {% end %}
            {% if defined(models) %}
            AND model IN splitByChar(',', {{ String(models) }})
            {% end %}
        GROUP BY bucket_dt, group_value

        UNION ALL

        SELECT
            if(use_daily, toStartOfDay(toDateTime(EventAt)), toStartOfHour(toDateTime(EventAt))) AS bucket_dt,
            multiIf({{ String(group_by, 'none') }} = 'source', toString(source), {{ String(group_by, 'none') }} = 'model', toString(model), {{ String(group_by, 'none') }} = 'repo', toString(repo_fingerprint), '') AS group_value,
            count() AS message_count,
            uniqExact(session_pk) AS session_count,
            sum(input_tokens) AS input_tokens,
            sum(output_tokens) AS output_tokens,
            sum(cache_read_tokens) AS cache_read_tokens,
            sum(cache_creation_tokens) AS cache_creation_tokens,
            sum(reasoning_tokens) AS reasoning_tokens,
            round(sum(ifNull(cost_usd, 0.)), 6) AS cost_usd_total,
            sum(toUInt64(cost_usd IS NOT NULL)) AS priced_message_count
        FROM agent_messages FINAL
        WHERE role = 'assistant'
            AND (
                EventAt < if(use_daily, wm_d_min, wm_h_min)
                OR EventAt >= if(use_daily, wm_d, wm_h)
            )
            AND OrgId = {{ String(org_id, '') }}
            AND EventAt >= start_dt
            AND EventAt < end_dt
            AND EventAt >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
            {% if defined(sources) %}
            AND source IN splitByChar(',', {{ String(sources) }})
            {% end %}
            {% if defined(repos) %}
            AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
            {% end %}
            {% if defined(models) %}
            AND model IN splitByChar(',', {{ String(models) }})
            {% end %}
        GROUP BY bucket_dt, group_value
    )

NODE tool_series
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms,
        {{ Int64(end_time_ms, 0) }} AS end_ms,
        if(end_ms = 0, toDateTime64(now(), 3), fromUnixTimestamp64Milli(end_ms)) AS end_dt,
        if(start_ms = 0, end_dt - toIntervalDay(7), fromUnixTimestamp64Milli(start_ms)) AS start_dt,
        dateDiff('day', start_dt, end_dt) AS range_days,
        {{ String(granularity, 'auto') }} AS granularity,
        (granularity = 'day' OR (granularity = 'auto' AND range_days > 30)) AS use_daily,
        (SELECT min(BucketStart) FROM agent_tool_usage_1h_v2 WHERE OrgId = {{ String(org_id, '') }}) AS wm_th_min,
        (SELECT max(BucketStart) FROM agent_tool_usage_1h_v2 WHERE OrgId = {{ String(org_id, '') }}) AS wm_th,
        (SELECT min(BucketStart) FROM agent_tool_usage_1d_v2 WHERE OrgId = {{ String(org_id, '') }}) AS wm_td_min,
        (SELECT max(BucketStart) FROM agent_tool_usage_1d_v2 WHERE OrgId = {{ String(org_id, '') }}) AS wm_td
    SELECT * FROM (
        SELECT
            BucketStart AS bucket_dt,
            multiIf({{ String(group_by, 'none') }} = 'source', toString(source), {{ String(group_by, 'none') }} = 'repo', toString(repo_fingerprint), '') AS group_value,
            sum(EventCount) AS tool_event_count,
            sum(SuccessCount) AS tool_success_count,
            sum(FailureCount) AS tool_failure_count,
            sum(UnknownCount) AS tool_unknown_count
        FROM agent_tool_usage_1h_v2
        WHERE NOT use_daily
            AND BucketStart >= wm_th_min
            AND BucketStart < wm_th
            AND OrgId = {{ String(org_id, '') }}
            AND BucketStart >= start_dt
            AND BucketStart < end_dt
            AND BucketStart >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
            {% if defined(sources) %}
            AND source IN splitByChar(',', {{ String(sources) }})
            {% end %}
            {% if defined(repos) %}
            AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
            {% end %}
        GROUP BY bucket_dt, group_value

        UNION ALL

        SELECT
            BucketStart AS bucket_dt,
            multiIf({{ String(group_by, 'none') }} = 'source', toString(source), {{ String(group_by, 'none') }} = 'repo', toString(repo_fingerprint), '') AS group_value,
            sum(EventCount) AS tool_event_count,
            sum(SuccessCount) AS tool_success_count,
            sum(FailureCount) AS tool_failure_count,
            sum(UnknownCount) AS tool_unknown_count
        FROM agent_tool_usage_1d_v2
        WHERE use_daily
            AND BucketStart >= wm_td_min
            AND BucketStart < wm_td
            AND OrgId = {{ String(org_id, '') }}
            AND BucketStart >= start_dt
            AND BucketStart < end_dt
            AND BucketStart >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
            {% if defined(sources) %}
            AND source IN splitByChar(',', {{ String(sources) }})
            {% end %}
            {% if defined(repos) %}
            AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
            {% end %}
        GROUP BY bucket_dt, group_value

        UNION ALL

        SELECT
            if(use_daily, toStartOfDay(toDateTime(EventAt)), toStartOfHour(toDateTime(EventAt))) AS bucket_dt,
            multiIf({{ String(group_by, 'none') }} = 'source', toString(source), {{ String(group_by, 'none') }} = 'repo', toString(repo_fingerprint), '') AS group_value,
            count() AS tool_event_count,
            countIf(status = 'success') AS tool_success_count,
            countIf(status = 'failure') AS tool_failure_count,
            countIf(status = 'unknown') AS tool_unknown_count
        FROM agent_tool_events FINAL
        WHERE (
                EventAt < if(use_daily, wm_td_min, wm_th_min)
                OR EventAt >= if(use_daily, wm_td, wm_th)
            )
            AND OrgId = {{ String(org_id, '') }}
            AND EventAt >= start_dt
            AND EventAt < end_dt
            AND EventAt >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
            {% if defined(sources) %}
            AND source IN splitByChar(',', {{ String(sources) }})
            {% end %}
            {% if defined(repos) %}
            AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
            {% end %}
        GROUP BY bucket_dt, group_value
    )

NODE endpoint
SQL >
    SELECT
        coalesce(u.bucket_dt, t.bucket_dt) AS bucket_start,
        coalesce(u.group_value, t.group_value) AS group_value,
        ifNull(u.message_count, 0) AS message_count,
        ifNull(u.session_count, 0) AS session_count,
        ifNull(u.input_tokens, 0) AS input_tokens,
        ifNull(u.output_tokens, 0) AS output_tokens,
        ifNull(u.cache_read_tokens, 0) AS cache_read_tokens,
        ifNull(u.cache_creation_tokens, 0) AS cache_creation_tokens,
        ifNull(u.reasoning_tokens, 0) AS reasoning_tokens,
        ifNull(u.total_tokens, 0) AS total_tokens,
        ifNull(u.cost_usd, 0.) AS cost_usd,
        ifNull(u.priced_message_count, 0) AS priced_message_count,
        ifNull(t.tool_event_count, 0) AS tool_event_count,
        ifNull(t.tool_success_count, 0) AS tool_success_count,
        ifNull(t.tool_failure_count, 0) AS tool_failure_count,
        ifNull(t.tool_unknown_count, 0) AS tool_unknown_count
    FROM usage_series AS u
    FULL OUTER JOIN tool_series AS t
        ON u.bucket_dt = t.bucket_dt AND u.group_value = t.group_value
    ORDER BY bucket_start ASC, group_value ASC
    SETTINGS join_use_nulls = 1

TYPE ENDPOINT
