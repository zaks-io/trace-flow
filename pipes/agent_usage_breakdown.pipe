DESCRIPTION >
    Ranked Agent usage breakdown by source, model, or repo. Reads the incremental
    hourly serving table only.

NODE breakdown
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms,
        {{ Int64(end_time_ms, 0) }} AS end_ms,
        if(end_ms = 0, toDateTime64(now(), 3), fromUnixTimestamp64Milli(end_ms)) AS end_dt,
        if(start_ms = 0, end_dt - toIntervalDay(7), fromUnixTimestamp64Milli(start_ms)) AS start_dt
    SELECT
        multiIf(
            {{ String(dimension, 'source') }} = 'model', toString(model),
            {{ String(dimension, 'source') }} = 'repo', toString(repo_fingerprint),
            toString(source)
        ) AS group_value,
        sum(finalizeAggregation(MessageCount)) AS message_count,
        uniqMerge(SessionCount) AS session_count,
        sum(finalizeAggregation(InputTokens)) + sum(finalizeAggregation(OutputTokens))
            + sum(finalizeAggregation(CacheReadTokens)) + sum(finalizeAggregation(CacheCreationTokens))
            + sum(finalizeAggregation(ReasoningTokens)) AS total_tokens,
        round(sum(finalizeAggregation(CostUsd)), 6) AS cost_usd
    FROM agent_usage_hourly
    WHERE OrgId = {{ String(org_id, '') }}
        AND BucketStart >= start_dt
        AND BucketStart < end_dt
        AND BucketStart >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
        {% if defined(sources) %}
        AND source IN splitByChar(',', {{ String(sources) }})
        {% end %}
        {% if defined(models) %}
        AND model IN splitByChar(',', {{ String(models) }})
        {% end %}
        {% if defined(repos) %}
        AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
        {% end %}
    GROUP BY group_value
    ORDER BY
        multiIf(
            {{ String(order_by, 'cost_usd') }} = 'total_tokens', toFloat64(total_tokens),
            {{ String(order_by, 'cost_usd') }} = 'message_count', toFloat64(message_count),
            {{ String(order_by, 'cost_usd') }} = 'session_count', toFloat64(session_count),
            cost_usd
        ) DESC,
        group_value ASC
    LIMIT {{ Int32(limit, 100) }}

TYPE ENDPOINT
