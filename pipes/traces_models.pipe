DESCRIPTION >
    Models breakdown by request count, filtered by API keys and time range.
    The api_keys parameter is enforced via JWT fixed_params for security.

NODE endpoint
SQL >
    %
    SELECT
        if(JSONExtractString(SpanAttributes, 'gen_ai.system') != '',
          concat(JSONExtractString(SpanAttributes, 'gen_ai.system'), '/',
            if(position(JSONExtractString(SpanAttributes, 'gen_ai.request.model'), '/') > 0,
              substringUTF8(JSONExtractString(SpanAttributes, 'gen_ai.request.model'),
                position(JSONExtractString(SpanAttributes, 'gen_ai.request.model'), '/') + 1),
              JSONExtractString(SpanAttributes, 'gen_ai.request.model'))),
          JSONExtractString(SpanAttributes, 'gen_ai.request.model')) as model,
        countDistinct(SpanId) as request_count
    FROM otel_trace_spans
    WHERE ParentSpanId = ''
        AND (
            ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
            OR has(arrayMap(key_identifier -> if(match(key_identifier, '^sha256:[0-9a-f]{64}$'), key_identifier, concat('sha256:', lower(hex(SHA256(key_identifier))))), splitByChar(',', {{ String(api_keys, '') }})), if(match(ApiKey, '^sha256:[0-9a-f]{64}$'), ApiKey, concat('sha256:', lower(hex(SHA256(ApiKey))))))
        )
        AND ReceivedAt >= toInt64(toUnixTimestamp(now() - toIntervalDay({{ Int32(retention_days, 7) }}))) * 1000000000
        AND ReceivedAt >= {{ Int64(start_time_ns, 0) }}
        AND JSONExtractString(SpanAttributes, 'gen_ai.request.model') != ''
    GROUP BY model
    ORDER BY request_count DESC
    LIMIT 10

TYPE ENDPOINT
