DESCRIPTION >
    Models breakdown by request count, filtered by API keys and time range.
    The api_keys parameter is enforced via JWT fixed_params for security.

NODE endpoint
SQL >
    %
    SELECT
        JSONExtractString(SpanAttributes, 'gen_ai.request.model') as model,
        countDistinct(SpanId) as request_count
    FROM otel_traces
    WHERE ParentSpanId = ''
        AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        AND ReceivedAt >= {{ Int64(start_time_ns, 0) }}
        AND JSONExtractString(SpanAttributes, 'gen_ai.request.model') != ''
    GROUP BY model
    ORDER BY request_count DESC
    LIMIT 10

TYPE ENDPOINT
