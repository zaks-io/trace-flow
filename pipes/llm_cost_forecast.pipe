DESCRIPTION >
    Run-rate cost forecast with confidence intervals, trend detection,
    and anomaly flagging. Uses last 30 days of daily data for variance
    and llm_usage_1h for accurate MTD.
    The api_keys parameter is enforced via JWT fixed_params for security.

NODE daily_costs
SQL >
    %
    SELECT
        toDate(BucketStart) AS day,
        sumMerge(TotalCostMicrodollars) / 1000000 AS cost_usd
    FROM llm_usage_1d
    WHERE BucketStart >= today() - INTERVAL 30 DAY
        AND BucketStart < today()
        AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        {% if defined(provider) %}
        AND Provider = {{ String(provider) }}
        {% end %}
        {% if defined(model) %}
        AND Model = {{ String(model) }}
        {% end %}
        {% if defined(baggage_operation) %}
        AND BaggageOperation = {{ String(baggage_operation) }}
        {% end %}
        {% if defined(api_key_filter) %}
        AND ApiKey = {{ String(api_key_filter) }}
        {% end %}
    GROUP BY day
    ORDER BY day

NODE daily_stats
SQL >
    SELECT
        avg(cost_usd) AS mean_cost,
        stddevSamp(cost_usd) AS stddev_cost
    FROM daily_costs

NODE anomalies
SQL >
    SELECT
        groupArray(
            tuple(
                toString(dc.day),
                dc.cost_usd,
                ds.mean_cost,
                if(ds.stddev_cost > 0, (dc.cost_usd - ds.mean_cost) / ds.stddev_cost, 0)
            )
        ) AS anomaly_list,
        length(anomaly_list) AS anomaly_count
    FROM daily_costs dc
    CROSS JOIN daily_stats ds
    WHERE ds.stddev_cost > 0
        AND abs(dc.cost_usd - ds.mean_cost) / ds.stddev_cost > 2

NODE endpoint
SQL >
    %
    WITH
        toDate(now()) AS current_date,
        toStartOfMonth(current_date) AS month_start,
        toLastDayOfMonth(current_date) AS month_end,
        toUInt32(current_date - month_start) + 1 AS days_elapsed,
        toUInt32(month_end - month_start) + 1 AS days_in_month,
        toUInt32(month_end - current_date) AS days_remaining,
        (SELECT stddev_cost FROM daily_stats) AS daily_stddev,
        -- MTD from hourly table for freshest data
        (
            SELECT coalesce(sumMerge(TotalCostMicrodollars) / 1000000, 0)
            FROM llm_usage_1h
            WHERE BucketStart >= month_start
                AND BucketStart <= now()
                AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
                {% if defined(provider) %}
                AND Provider = {{ String(provider) }}
                {% end %}
                {% if defined(model) %}
                AND Model = {{ String(model) }}
                {% end %}
                {% if defined(baggage_operation) %}
                AND BaggageOperation = {{ String(baggage_operation) }}
                {% end %}
                {% if defined(api_key_filter) %}
                AND ApiKey = {{ String(api_key_filter) }}
                {% end %}
        ) AS mtd_cost,
        -- Run-rate projection: scale current pace to full month
        mtd_cost / greatest(days_elapsed, 1) * days_in_month AS projected,
        -- Confidence interval based on daily variance
        coalesce(daily_stddev, 0) * 1.645 * sqrt(greatest(days_remaining, 0)) AS ci_margin,
        -- Trend: last 7 days avg vs prior 7 days avg
        (
            SELECT avg(cost_usd)
            FROM daily_costs
            WHERE day >= today() - 7
        ) AS recent_7d_avg,
        (
            SELECT avg(cost_usd)
            FROM daily_costs
            WHERE day >= today() - 14 AND day < today() - 7
        ) AS prior_7d_avg
    SELECT
        projected AS projected_monthly_cost,
        mtd_cost AS month_to_date_cost,
        greatest(mtd_cost, projected - ci_margin) AS confidence_low,
        projected + ci_margin AS confidence_high,
        mtd_cost / greatest(days_elapsed, 1) AS daily_average,
        days_elapsed AS days_elapsed_in_month,
        days_remaining AS days_remaining_in_month,
        multiIf(
            prior_7d_avg IS NULL OR prior_7d_avg = 0 OR recent_7d_avg IS NULL, 'stable',
            (recent_7d_avg - prior_7d_avg) / prior_7d_avg > 0.05, 'up',
            (recent_7d_avg - prior_7d_avg) / prior_7d_avg < -0.05, 'down',
            'stable'
        ) AS trend,
        if(prior_7d_avg IS NULL OR prior_7d_avg = 0 OR recent_7d_avg IS NULL, 0,
            (recent_7d_avg - prior_7d_avg) / prior_7d_avg * 100
        ) AS trend_percent,
        coalesce((SELECT anomaly_count FROM anomalies), 0) AS anomaly_count,
        (SELECT anomaly_list FROM anomalies) AS anomalies,
        if(mtd_cost = 0, 1, 0) AS insufficient_data

TYPE ENDPOINT
