DESCRIPTION >
    Day-of-week decomposed cost forecast with calendar-aware projection,
    confidence intervals, trend detection, and anomaly flagging.
    Uses last 90 days of daily data from llm_usage_1d.
    The api_keys parameter is enforced via JWT fixed_params for security.

NODE daily_costs
SQL >
    %
    SELECT
        toDate(BucketStart) AS day,
        toDayOfWeek(BucketStart) AS dow,
        sumMerge(TotalCostMicrodollars) / 1000000 AS cost_usd
    FROM llm_usage_1d
    WHERE BucketStart >= today() - INTERVAL 90 DAY
        AND BucketStart < today()
        AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        {% if defined(provider) %}
        AND Provider = {{ String(provider) }}
        {% end %}
        {% if defined(model) %}
        AND Model = {{ String(model) }}
        {% end %}
        {% if defined(baggage_operation) %}
        AND BaggageOperation = {{ String(baggage_operation) }}
        {% end %}
        {% if defined(api_key_filter) %}
        AND ApiKey = {{ String(api_key_filter) }}
        {% end %}
    GROUP BY day, dow
    ORDER BY day

NODE dow_stats
SQL >
    SELECT
        dow,
        avg(cost_usd) AS mean_cost,
        varSamp(cost_usd) AS variance_cost,
        stddevSamp(cost_usd) AS stddev_cost,
        count() AS sample_count
    FROM daily_costs
    GROUP BY dow

NODE anomalies
SQL >
    SELECT
        groupArray(
            tuple(
                toString(dc.day),
                dc.cost_usd,
                ds.mean_cost,
                if(ds.stddev_cost > 0, (dc.cost_usd - ds.mean_cost) / ds.stddev_cost, 0)
            )
        ) AS anomaly_list,
        length(anomaly_list) AS anomaly_count
    FROM daily_costs dc
    INNER JOIN dow_stats ds ON dc.dow = ds.dow
    WHERE ds.stddev_cost > 0
        AND abs(dc.cost_usd - ds.mean_cost) / ds.stddev_cost > 2

NODE endpoint
SQL >
    %
    WITH
        toDate(now()) AS current_date,
        toStartOfMonth(current_date) AS month_start,
        toLastDayOfMonth(current_date) AS month_end,
        toUInt32(current_date - month_start) + 1 AS days_elapsed,
        toUInt32(month_end - current_date) AS days_remaining,
        (SELECT count(DISTINCT day) FROM daily_costs) AS total_history_days,
        -- MTD actual: includes today's partial data
        (
            SELECT sumMerge(TotalCostMicrodollars) / 1000000
            FROM llm_usage_1d
            WHERE BucketStart >= month_start
                AND BucketStart <= current_date
                AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
                {% if defined(provider) %}
                AND Provider = {{ String(provider) }}
                {% end %}
                {% if defined(model) %}
                AND Model = {{ String(model) }}
                {% end %}
                {% if defined(baggage_operation) %}
                AND BaggageOperation = {{ String(baggage_operation) }}
                {% end %}
                {% if defined(api_key_filter) %}
                AND ApiKey = {{ String(api_key_filter) }}
                {% end %}
        ) AS mtd_cost,
        -- Sum of DOW means for remaining days
        (
            SELECT coalesce(sum(ds.mean_cost), 0)
            FROM numbers(days_remaining) n
            INNER JOIN dow_stats ds
                ON ds.dow = toDayOfWeek(current_date + toUInt32(n.number) + 1)
        ) AS remaining_mean_sum,
        -- Sum of DOW variances for remaining days (for confidence interval)
        (
            SELECT coalesce(sum(ds.variance_cost), 0)
            FROM numbers(days_remaining) n
            INNER JOIN dow_stats ds
                ON ds.dow = toDayOfWeek(current_date + toUInt32(n.number) + 1)
        ) AS remaining_variance_sum,
        -- Trend: last 7 days avg vs prior 7 days avg
        (
            SELECT avg(cost_usd)
            FROM daily_costs
            WHERE day >= today() - 7
        ) AS recent_7d_avg,
        (
            SELECT avg(cost_usd)
            FROM daily_costs
            WHERE day >= today() - 14 AND day < today() - 7
        ) AS prior_7d_avg
    SELECT
        if(total_history_days < 14, 0, coalesce(mtd_cost, 0) + remaining_mean_sum)
            AS projected_monthly_cost,
        coalesce(mtd_cost, 0) AS month_to_date_cost,
        if(total_history_days < 14, 0,
            greatest(0, coalesce(mtd_cost, 0) + remaining_mean_sum - 1.645 * sqrt(remaining_variance_sum))
        ) AS confidence_low,
        if(total_history_days < 14, 0,
            coalesce(mtd_cost, 0) + remaining_mean_sum + 1.645 * sqrt(remaining_variance_sum)
        ) AS confidence_high,
        if(total_history_days > 0,
            (SELECT sum(cost_usd) FROM daily_costs) / total_history_days,
            0
        ) AS daily_average,
        total_history_days AS basis_days,
        days_elapsed AS days_elapsed_in_month,
        days_remaining AS days_remaining_in_month,
        multiIf(
            prior_7d_avg IS NULL OR prior_7d_avg = 0 OR recent_7d_avg IS NULL, 'stable',
            (recent_7d_avg - prior_7d_avg) / prior_7d_avg > 0.05, 'up',
            (recent_7d_avg - prior_7d_avg) / prior_7d_avg < -0.05, 'down',
            'stable'
        ) AS trend,
        if(prior_7d_avg IS NULL OR prior_7d_avg = 0 OR recent_7d_avg IS NULL, 0,
            (recent_7d_avg - prior_7d_avg) / prior_7d_avg * 100
        ) AS trend_percent,
        (SELECT anomaly_count FROM anomalies) AS anomaly_count,
        (SELECT anomaly_list FROM anomalies) AS anomalies,
        if(total_history_days < 14, 1, 0) AS insufficient_data

TYPE ENDPOINT
