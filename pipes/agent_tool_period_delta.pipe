DESCRIPTION >
    Period-over-period movement for (tool_name, command_family): the requested
    window versus the immediately-preceding window of equal length. Lambda over
    `agent_tool_usage_1h` replacement snapshots plus base `agent_tool_events FINAL`:
    snapshots serve buckets inside [min(BucketStart), max(BucketStart)), while base FINAL
    serves older history and the live tail. The union is re-aggregated by
    (tool_name, command_family). Counts are exact either way (the tool rollup holds only
    count/sum values). Sorted by absolute change in event volume. `org_id` is enforced via
    the JWT `fixed_params`.

NODE delta
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms_raw,
        {{ Int64(end_time_ms, 0) }} AS end_ms_raw,
        if(end_ms_raw = 0, toUnixTimestamp64Milli(toDateTime64(now(), 3)), end_ms_raw) AS end_ms_candidate,
        if(start_ms_raw = 0, end_ms_candidate - 7 * 24 * 60 * 60 * 1000, start_ms_raw) AS start_ms_candidate,
        least(start_ms_candidate, end_ms_candidate) AS start_ms,
        greatest(start_ms_candidate, end_ms_candidate) AS end_ms,
        end_ms - start_ms AS span_ms,
        fromUnixTimestamp64Milli(start_ms) AS start_dt,
        fromUnixTimestamp64Milli(end_ms) AS end_dt,
        fromUnixTimestamp64Milli(start_ms - span_ms) AS prior_start_dt,
        (SELECT min(BucketStart) FROM agent_tool_usage_1h WHERE OrgId = {{ String(org_id, '') }}) AS rollup_min,
        (SELECT max(BucketStart) FROM agent_tool_usage_1h WHERE OrgId = {{ String(org_id, '') }}) AS rollup_watermark
    SELECT
        tool_name,
        command_family,
        sum(current_count) AS current_count,
        sum(prior_count) AS prior_count,
        toInt64(current_count) - toInt64(prior_count) AS count_delta,
        sum(current_failures) AS current_failures,
        sum(prior_failures) AS prior_failures,
        toInt64(current_failures) - toInt64(prior_failures) AS failure_delta
    FROM (
        SELECT
            tool_name,
            command_family,
            sumIf(EventCount, BucketStart >= start_dt AND BucketStart < end_dt) AS current_count,
            sumIf(EventCount, BucketStart >= prior_start_dt AND BucketStart < start_dt) AS prior_count,
            sumIf(FailureCount, BucketStart >= start_dt AND BucketStart < end_dt) AS current_failures,
            sumIf(FailureCount, BucketStart >= prior_start_dt AND BucketStart < start_dt) AS prior_failures
        FROM agent_tool_usage_1h
        WHERE BucketStart >= rollup_min
            AND BucketStart < rollup_watermark
            AND OrgId = {{ String(org_id, '') }}
            AND BucketStart >= prior_start_dt
            AND BucketStart < end_dt
            AND BucketStart >= now() - toIntervalDay({{ Int32(retention_days, 14) }})
            {% if defined(sources) %}
            AND source IN splitByChar(',', {{ String(sources) }})
            {% end %}
            {% if defined(repos) %}
            AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
            {% end %}
            {% if defined(repo_fingerprint) %}
            AND repo_fingerprint = {{ String(repo_fingerprint) }}
            {% end %}
        GROUP BY tool_name, command_family

        UNION ALL

        SELECT
            tool_name,
            command_family,
            countIf(EventAt >= start_dt AND EventAt < end_dt) AS current_count,
            countIf(EventAt >= prior_start_dt AND EventAt < start_dt) AS prior_count,
            countIf(EventAt >= start_dt AND EventAt < end_dt AND status = 'failure') AS current_failures,
            countIf(EventAt >= prior_start_dt AND EventAt < start_dt AND status = 'failure') AS prior_failures
        FROM agent_tool_events FINAL
        WHERE (EventAt < rollup_min OR EventAt >= rollup_watermark)
            AND OrgId = {{ String(org_id, '') }}
            AND EventAt >= prior_start_dt
            AND EventAt < end_dt
            AND EventAt >= now() - toIntervalDay({{ Int32(retention_days, 14) }})
            {% if defined(sources) %}
            AND source IN splitByChar(',', {{ String(sources) }})
            {% end %}
            {% if defined(repos) %}
            AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
            {% end %}
            {% if defined(repo_fingerprint) %}
            AND repo_fingerprint = {{ String(repo_fingerprint) }}
            {% end %}
        GROUP BY tool_name, command_family
    )
    GROUP BY tool_name, command_family
    HAVING current_count > 0 OR prior_count > 0
    ORDER BY abs(count_delta) DESC, tool_name ASC, command_family ASC
    LIMIT {{ Int32(limit, 100) }}

TYPE ENDPOINT
