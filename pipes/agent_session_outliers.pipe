DESCRIPTION >
    Session outliers: top sessions by estimated cost and file-touch count over a
    window (the "$400 / 200 files" case). Query-time aggregate over
    `agent_messages FINAL` and `agent_file_events FINAL` — the query-time-first
    launch path; the materialized `agent_sessions` rebuild is the 1c canonical
    aggregate, not this pipe. `cost_usd` is summed across priced messages (null
    per-message cost is skipped by `sum`); sessions rank by cost then file count.
    `org_id` is enforced via the JWT `fixed_params`.

NODE session_messages
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms,
        {{ Int64(end_time_ms, 0) }} AS end_ms,
        if(start_ms = 0, toDateTime64(now() - toIntervalDay(7), 3), fromUnixTimestamp64Milli(start_ms)) AS start_dt,
        if(end_ms = 0, toDateTime64(now(), 3), fromUnixTimestamp64Milli(end_ms)) AS end_dt
    SELECT
        OrgId,
        session_pk,
        any(source) AS source,
        any(repo_fingerprint) AS repo_fingerprint,
        count() AS message_count,
        sum(cost_usd) AS cost_usd,
        max(EventAt) AS last_event_at
    FROM agent_messages FINAL
    WHERE OrgId = {{ String(org_id, '') }}
        AND EventAt >= start_dt
        AND EventAt < end_dt
        AND EventAt >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
        {% if defined(source) %}
        AND source = {{ String(source) }}
        {% end %}
        {% if defined(repo_fingerprint) %}
        AND repo_fingerprint = {{ String(repo_fingerprint) }}
        {% end %}
    GROUP BY OrgId, session_pk

NODE session_files
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms,
        {{ Int64(end_time_ms, 0) }} AS end_ms,
        if(start_ms = 0, toDateTime64(now() - toIntervalDay(7), 3), fromUnixTimestamp64Milli(start_ms)) AS start_dt,
        if(end_ms = 0, toDateTime64(now(), 3), fromUnixTimestamp64Milli(end_ms)) AS end_dt
    SELECT
        session_pk,
        count() AS file_event_count,
        uniqExact(normalized_repo_path) AS unique_file_count
    FROM agent_file_events FINAL
    WHERE OrgId = {{ String(org_id, '') }}
        AND EventAt >= start_dt
        AND EventAt < end_dt
        AND EventAt >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
        {% if defined(source) %}
        AND source = {{ String(source) }}
        {% end %}
        {% if defined(repo_fingerprint) %}
        AND repo_fingerprint = {{ String(repo_fingerprint) }}
        {% end %}
    GROUP BY session_pk

NODE endpoint
SQL >
    %
    SELECT
        m.session_pk AS session_pk,
        m.source AS source,
        m.repo_fingerprint AS repo_fingerprint,
        m.message_count AS message_count,
        ifNull(f.file_event_count, 0) AS file_event_count,
        ifNull(f.unique_file_count, 0) AS unique_file_count,
        m.cost_usd AS cost_usd
    FROM session_messages AS m
    LEFT JOIN session_files AS f USING (session_pk)
    ORDER BY cost_usd DESC NULLS LAST, file_event_count DESC, session_pk ASC
    LIMIT {{ Int32(limit, 100) }}

TYPE ENDPOINT
