DESCRIPTION >
    Get spans for a specific trace with server-side filtering, sorting, and pagination.
    Used by MCP tools. The api_keys parameter is enforced via JWT fixed_params for security.

NODE endpoint
SQL >
    %
    SELECT
        ReceivedAt,
        Timestamp,
        TraceId,
        SpanId,
        ParentSpanId,
        SpanName,
        Duration,
        StatusCode,
        StatusMessage,
        SpanAttributes,
        `Events.Timestamp` as EventTimestamps,
        `Events.Name` as EventNames,
        `Events.Attributes` as EventAttributes,
        count(*) OVER() as total_count
    FROM otel_traces
    WHERE TraceId = {{ String(trace_id, '') }}
        AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        {% if defined(span_id) %}
        AND SpanId = {{ String(span_id) }}
        {% end %}
        {% if defined(span_names) %}
        AND SpanName IN splitByChar(',', {{ String(span_names) }})
        {% end %}
        {% if defined(span_name_prefixes) %}
        AND SpanName LIKE any(arrayMap(x -> concat(x, '%'), splitByChar(',', {{ String(span_name_prefixes) }})))
        {% end %}
        {% if defined(exclude_span_names) %}
        AND SpanName NOT IN splitByChar(',', {{ String(exclude_span_names) }})
        {% end %}
        {% if defined(min_duration_ms) %}
        AND Duration >= {{ Int64(min_duration_ms) }} * 1000000
        {% end %}
    ORDER BY
        {% if defined(sort_by) and sort_by == 'cost_usd' %}
        JSONExtractFloat(SpanAttributes, 'ai.cost.total')
        {% elif defined(sort_by) and sort_by == 'tokens' %}
        JSONExtractInt(SpanAttributes, 'ai.tokens.total')
        {% elif defined(sort_by) and sort_by == 'duration_ms' %}
        Duration
        {% else %}
        Timestamp
        {% end %}
        {% if defined(order) and order == 'desc' %}DESC{% else %}ASC{% end %}
    LIMIT {{ Int32(limit, 100) }}
    OFFSET {{ Int32(offset, 0) }}

TYPE ENDPOINT
