DESCRIPTION >
    List individual spans filtered by API keys with optional filtering by provider, model, and status.
    The api_keys parameter is enforced via JWT fixed_params for security.
    Returns all spans (no deduplication) - each span is a separate row.

NODE endpoint
SQL >
    %
    {% if (defined(client_source) != (defined(client_session_id) or defined(client_parent_session_id))) or (defined(client_agent_id) and not (defined(client_source) and defined(client_session_id))) %}
    {{ error('Client lookup requires paired source and session or parent', 400) }}
    {% end %}
    SELECT
        ReceivedAt,
        Timestamp,
        TraceId,
        SpanId,
        SpanName,
        ServiceName,
        Duration,
        StatusCode,
        SpanAttributes,
        BaggageOperation,
        -- Must match AccountKey in materialize_llm_execution_accounts so account drilldowns reconcile.
        if(
            JSONExtractString(SpanAttributes, 'trace_flow.source') = 'imported_execution',
            concat(
                lower(JSONExtractString(ResourceAttributes, 'cliproxyapi.installation.id')), '/',
                JSONExtractString(SpanAttributes, 'gen_ai.system'), '/',
                JSONExtractString(SpanAttributes, 'cliproxyapi.account.coverage'), '/',
                JSONExtractString(SpanAttributes, 'cliproxyapi.account.ref')
            ),
            ''
        ) AS AccountKey
    FROM otel_genai_spans
    WHERE JSONExtractString(SpanAttributes, 'trace_flow.source') IN ('proxy', 'imported_execution')
        AND (
            ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
            OR has(arrayMap(key_identifier -> if(match(key_identifier, '^sha256:[0-9a-f]{64}$'), key_identifier, concat('sha256:', lower(hex(SHA256(key_identifier))))), splitByChar(',', {{ String(api_keys, '') }})), if(match(ApiKey, '^sha256:[0-9a-f]{64}$'), ApiKey, concat('sha256:', lower(hex(SHA256(ApiKey))))))
        )
        AND ReceivedAt >= toInt64(toUnixTimestamp(now() - toIntervalDay({{ Int32(retention_days, 7) }}))) * 1000000000
        {% if defined(client_source) %}
        AND JSONExtractString(SpanAttributes, 'trace_flow.source') = 'imported_execution'
        AND JSONExtractString(SpanAttributes, 'cliproxyapi.client.source') = {{ String(client_source) }}
        {% end %}
        {% if defined(client_session_id) %}
        AND JSONExtractString(SpanAttributes, 'cliproxyapi.client.session.id') = {{ String(client_session_id) }}
        {% end %}
        {% if defined(client_agent_id) %}
        AND JSONExtractString(SpanAttributes, 'trace_flow.source') = 'imported_execution'
        AND JSONExtractString(SpanAttributes, 'cliproxyapi.client.agent.id') = {{ String(client_agent_id) }}
        {% end %}
        {% if defined(client_parent_session_id) %}
        AND JSONExtractString(SpanAttributes, 'cliproxyapi.client.session.parent_id') = {{ String(client_parent_session_id) }}
        {% end %}
        {% if defined(inbound_trace_id) %}
        AND JSONExtractString(SpanAttributes, 'trace_flow.source') = 'imported_execution'
        AND JSONExtractString(SpanAttributes, 'cliproxyapi.inbound.trace_id') = {{ String(inbound_trace_id) }}
        {% end %}
        {% if defined(request_id) %}
        AND JSONExtractString(SpanAttributes, 'trace_flow.source') = 'imported_execution'
        AND JSONExtractString(SpanAttributes, 'cliproxyapi.request.id') = {{ String(request_id) }}
        {% end %}
        {% if defined(execution_id) %}
        AND JSONExtractString(SpanAttributes, 'trace_flow.source') = 'imported_execution'
        AND JSONExtractString(SpanAttributes, 'cliproxyapi.execution.id') = {{ String(execution_id) }}
        {% end %}
        {% if defined(provider) %}
        AND Provider = {{ String(provider) }}
        {% end %}
        {% if defined(model) %}
        AND Model = {{ String(model) }}
        {% end %}
        {% if defined(status) %}
        AND StatusCode = {{ String(status) }}
        {% end %}
        {% if defined(operation) %}
        AND BaggageOperation = {{ String(operation) }}
        {% end %}
        {% if defined(search) %}
        AND TraceId = {{ String(search) }}
        {% end %}
        {% if defined(api_key_filter) %}
        AND (
            ApiKey = {{ String(api_key_filter) }}
            OR if(match(ApiKey, '^sha256:[0-9a-f]{64}$'), ApiKey, concat('sha256:', lower(hex(SHA256(ApiKey))))) = if(match({{ String(api_key_filter) }}, '^sha256:[0-9a-f]{64}$'), {{ String(api_key_filter) }}, concat('sha256:', lower(hex(SHA256({{ String(api_key_filter) }})))))
        )
        {% end %}
        {% if defined(account) %}
        AND AccountKey = {{ String(account) }}
        {% end %}
        {% if defined(after_received_at) %}
        AND ReceivedAt > {{ Int64(after_received_at) }}
        {% end %}
    ORDER BY ReceivedAt DESC
    LIMIT {{ Int32(limit, 100) }}

TYPE ENDPOINT
