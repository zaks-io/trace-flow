DESCRIPTION >
    List individual spans filtered by API keys with optional filtering by provider, model, and status.
    The api_keys parameter is enforced via JWT fixed_params for security.
    Returns all spans (no deduplication) - each span is a separate row.

NODE endpoint
SQL >
    %
    SELECT
        ReceivedAt,
        Timestamp,
        TraceId,
        SpanId,
        SpanName,
        ServiceName,
        Duration,
        StatusCode,
        SpanAttributes,
        BaggageOperation
    FROM otel_traces_genai
    WHERE JSONExtractString(SpanAttributes, 'trace_flow.source') = 'proxy'
        AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        AND ReceivedAt >= toInt64(toUnixTimestamp(now() - toIntervalDay({{ Int32(retention_days, 7) }}))) * 1000000000
        {% if defined(provider) %}
        AND Provider = {{ String(provider) }}
        {% end %}
        {% if defined(model) %}
        AND Model = {{ String(model) }}
        {% end %}
        {% if defined(status) %}
        AND StatusCode = {{ String(status) }}
        {% end %}
        {% if defined(operation) %}
        AND BaggageOperation = {{ String(operation) }}
        {% end %}
        {% if defined(search) %}
        AND TraceId = {{ String(search) }}
        {% end %}
        {% if defined(api_key_filter) %}
        AND ApiKey = {{ String(api_key_filter) }}
        {% end %}
        {% if defined(after_received_at) %}
        AND ReceivedAt > {{ Int64(after_received_at) }}
        {% end %}
    ORDER BY ReceivedAt DESC
    LIMIT {{ Int32(limit, 100) }}

TYPE ENDPOINT
