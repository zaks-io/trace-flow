DESCRIPTION >
    Dashboard summary statistics filtered by API keys and time range.
    The api_keys parameter is enforced via JWT fixed_params for security.

NODE endpoint
SQL >
    %
    SELECT
        countIf(ParentSpanId = '') as total_requests,
        count() as total_traces,
        avgIf(
            JSONExtractFloat(SpanAttributes, 'gen_ai.server.time_to_first_token'),
            JSONHas(SpanAttributes, 'gen_ai.operation.name') AND JSONHas(SpanAttributes, 'gen_ai.server.time_to_first_token')
        ) as avg_ttft_ms,
        avgIf(Duration, ParentSpanId = '') / 1000000 as avg_duration_ms,
        countIf(StatusCode = 'STATUS_CODE_ERROR' AND ParentSpanId = '') * 100.0 /
            nullIf(countIf(ParentSpanId = ''), 0) as error_rate_percent,
        sumIf(
            JSONExtractInt(SpanAttributes, 'gen_ai.usage.input_tokens'),
            ParentSpanId = ''
        ) as total_input_tokens,
        sumIf(
            JSONExtractInt(SpanAttributes, 'gen_ai.usage.output_tokens'),
            ParentSpanId = ''
        ) as total_output_tokens
    FROM otel_traces
    WHERE ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        AND ReceivedAt >= {{ Int64(start_time_ns, 0) }}

TYPE ENDPOINT
