DESCRIPTION >
    Bounded status read for snapshot Copy jobs started by the snapshot worker.

NODE endpoint
SQL >
    %
    SELECT job_id AS id, status
    FROM tinybird.jobs_log
    WHERE created_at >= now() - INTERVAL 10 MINUTE
      AND job_id = {{ String(job_id) }}
      AND job_type IN ('copy', 'copy_from_branch')
      AND JSONExtractString(job_metadata, 'pipe_name') IN (
        'repair_agent_context_call_buckets_hourly_snapshots',
        'repair_agent_repositories_snapshots',
        'repair_agent_session_file_signals_snapshots',
        'repair_agent_session_signals_snapshots',
        'repair_agent_session_summaries_snapshots',
        'repair_agent_tool_usage_daily_snapshots',
        'repair_agent_tool_usage_hourly_snapshots',
        'repair_agent_usage_daily_snapshots',
        'repair_agent_usage_hourly_snapshots'
      )
    LIMIT 1

TYPE ENDPOINT

TOKEN agent_snapshot_worker READ
TOKEN trace_flow_agent_snapshot_worker READ
