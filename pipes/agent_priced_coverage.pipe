DESCRIPTION >
    Priced-token coverage for Agent Message usage. Reads the incremental hourly
    serving table rather than raw message facts.

NODE coverage
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms,
        {{ Int64(end_time_ms, 0) }} AS end_ms,
        if(end_ms = 0, toDateTime64(now(), 3), fromUnixTimestamp64Milli(end_ms)) AS end_dt,
        if(start_ms = 0, end_dt - toIntervalDay(7), fromUnixTimestamp64Milli(start_ms)) AS start_dt
    SELECT
        sum(finalizeAggregation(MessageCount)) AS message_count,
        message_count AS billable_message_count,
        sum(finalizeAggregation(PricedMessageCount)) AS priced_message_count,
        if(
            billable_message_count = 0,
            CAST(NULL, 'Nullable(Float64)'),
            round(priced_message_count / billable_message_count, 4)
        ) AS coverage_pct,
        round(sum(finalizeAggregation(CostUsd)), 6) AS estimated_cost_usd
    FROM agent_usage_hourly
    WHERE OrgId = {{ String(org_id, '') }}
        AND BucketStart >= start_dt
        AND BucketStart < end_dt
        AND BucketStart >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
        {% if defined(source) %}
        AND source = {{ String(source) }}
        {% end %}
        {% if defined(repo_fingerprint) %}
        AND repo_fingerprint = {{ String(repo_fingerprint) }}
        {% end %}

TYPE ENDPOINT
