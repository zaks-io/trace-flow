DESCRIPTION >
    Grouped traces view with aggregated statistics, filtered by API keys.
    Uses otel_traces_genai materialized view for efficient filtering.
    The api_keys parameter is enforced via JWT fixed_params for security.

NODE filter_traces
DESCRIPTION >
    Filter TraceIds using the materialized view's indexed columns.
SQL >
    %
    SELECT DISTINCT TraceId
    FROM otel_traces_genai
    WHERE ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        {% if defined(after_received_at) %}
        AND ReceivedAt > {{ Int64(after_received_at) }}
        {% end %}
        {% if defined(provider) %}
        AND Provider = {{ String(provider) }}
        {% end %}
        {% if defined(model) %}
        AND Model = {{ String(model) }}
        {% end %}
        {% if defined(status) %}
        AND StatusCode = {{ String(status) }}
        {% end %}
        {% if defined(operation) %}
        AND BaggageOperation = {{ String(operation) }}
        {% end %}
        {% if defined(search) %}
        AND TraceId = {{ String(search) }}
        {% end %}
        {% if defined(api_key_filter) %}
        AND ApiKey = {{ String(api_key_filter) }}
        {% end %}
    ORDER BY TraceId DESC
    LIMIT {{ Int32(limit, 100) * 10 }}

NODE endpoint
DESCRIPTION >
    Aggregate spans for the filtered traces.
    When filters are active, uses MV subquery for efficient indexed lookup.
    When no filters, queries otel_traces directly to avoid subquery overhead.
SQL >
    %
    SELECT
        TraceId,
        countDistinct(SpanId) as ChildSpanCount,
        min(Timestamp) as FirstTimestamp,
        max(Timestamp) as LastTimestamp,
        max(ReceivedAt) as LatestReceivedAt,
        sum(Duration) as TotalDuration,
        avg(Duration) as AvgDuration,
        max(Duration) as MaxDuration,
        countIf(StatusCode = 'ERROR') as ErrorCount,
        groupArray(DISTINCT JSONExtractString(SpanAttributes, 'gen_ai.request.model')) as Models,
        sum(toInt64OrZero(JSONExtractString(SpanAttributes, 'gen_ai.usage.input_tokens')) + toInt64OrZero(JSONExtractString(SpanAttributes, 'gen_ai.usage.output_tokens'))) as TotalTokens,
        sum(toInt64OrZero(JSONExtractString(SpanAttributes, 'gen_ai.usage.input_tokens'))) as PromptTokens,
        sum(toInt64OrZero(JSONExtractString(SpanAttributes, 'gen_ai.usage.output_tokens'))) as CompletionTokens,
        max(toFloat64OrZero(JSONExtractString(SpanAttributes, 'gen_ai.server.time_to_first_token'))) as MaxTTFT,
        sum(toFloat64OrZero(JSONExtractString(SpanAttributes, 'gen_ai.cost.total'))) as TotalCost
    FROM otel_traces
    WHERE {% if defined(provider) or defined(model) or defined(status) or defined(operation) or defined(search) or defined(api_key_filter) %}
        TraceId IN (SELECT TraceId FROM filter_traces)
        AND {% end %}
        JSONExtractString(SpanAttributes, 'trace_flow.source') = 'proxy'
        AND ApiKey IN splitByChar(',', {{ String(api_keys, '') }})
        {% if not (defined(provider) or defined(model) or defined(status) or defined(operation) or defined(search) or defined(api_key_filter)) and defined(after_received_at) %}
        AND ReceivedAt > {{ Int64(after_received_at) }}
        {% end %}
    GROUP BY TraceId
    ORDER BY LatestReceivedAt DESC
    LIMIT {{ Int32(limit, 100) }}

TYPE ENDPOINT
