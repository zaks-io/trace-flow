DESCRIPTION >
    Headline KPIs for the Agent usage explorer. Reads the incremental hourly serving
    table only, so dashboard summary queries do not scan raw message facts.

NODE summary
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms_raw,
        {{ Int64(end_time_ms, 0) }} AS end_ms_raw,
        if(end_ms_raw = 0, toUnixTimestamp64Milli(toDateTime64(now(), 3)), end_ms_raw) AS end_ms_candidate,
        if(start_ms_raw = 0, end_ms_candidate - 7 * 24 * 60 * 60 * 1000, start_ms_raw) AS start_ms_candidate,
        least(start_ms_candidate, end_ms_candidate) AS start_ms,
        greatest(start_ms_candidate, end_ms_candidate) AS end_ms,
        end_ms - start_ms AS span_ms,
        fromUnixTimestamp64Milli(start_ms) AS start_dt,
        fromUnixTimestamp64Milli(end_ms) AS end_dt,
        fromUnixTimestamp64Milli(start_ms - span_ms) AS prior_start_dt
    SELECT
        round(sumIf(finalizeAggregation(CostUsd), BucketStart >= start_dt AND BucketStart < end_dt), 6) AS estimated_cost_usd,
        sumIf(finalizeAggregation(InputTokens), BucketStart >= start_dt AND BucketStart < end_dt)
            + sumIf(finalizeAggregation(OutputTokens), BucketStart >= start_dt AND BucketStart < end_dt)
            + sumIf(finalizeAggregation(CacheReadTokens), BucketStart >= start_dt AND BucketStart < end_dt)
            + sumIf(finalizeAggregation(CacheCreationTokens), BucketStart >= start_dt AND BucketStart < end_dt)
            + sumIf(finalizeAggregation(ReasoningTokens), BucketStart >= start_dt AND BucketStart < end_dt) AS total_tokens,
        sumIf(finalizeAggregation(MessageCount), BucketStart >= start_dt AND BucketStart < end_dt) AS message_count,
        uniqMergeIf(SessionCount, BucketStart >= start_dt AND BucketStart < end_dt) AS session_count,
        sumIf(finalizeAggregation(PricedMessageCount), BucketStart >= start_dt AND BucketStart < end_dt) AS priced_message_count,
        if(
            message_count = 0,
            CAST(NULL, 'Nullable(Float64)'),
            round(priced_message_count / message_count, 4)
        ) AS coverage_pct,
        round(sumIf(finalizeAggregation(CostUsd), BucketStart >= prior_start_dt AND BucketStart < start_dt), 6) AS prior_cost_usd,
        sumIf(finalizeAggregation(InputTokens), BucketStart >= prior_start_dt AND BucketStart < start_dt)
            + sumIf(finalizeAggregation(OutputTokens), BucketStart >= prior_start_dt AND BucketStart < start_dt)
            + sumIf(finalizeAggregation(CacheReadTokens), BucketStart >= prior_start_dt AND BucketStart < start_dt)
            + sumIf(finalizeAggregation(CacheCreationTokens), BucketStart >= prior_start_dt AND BucketStart < start_dt)
            + sumIf(finalizeAggregation(ReasoningTokens), BucketStart >= prior_start_dt AND BucketStart < start_dt) AS prior_total_tokens,
        sumIf(finalizeAggregation(MessageCount), BucketStart >= prior_start_dt AND BucketStart < start_dt) AS prior_message_count,
        uniqMergeIf(SessionCount, BucketStart >= prior_start_dt AND BucketStart < start_dt) AS prior_session_count
    FROM agent_usage_hourly
    WHERE OrgId = {{ String(org_id, '') }}
        AND BucketStart >= prior_start_dt
        AND BucketStart < end_dt
        {% if defined(sources) %}
        AND source IN splitByChar(',', {{ String(sources) }})
        {% end %}
        {% if defined(models) %}
        AND model IN splitByChar(',', {{ String(models) }})
        {% end %}
        {% if defined(repos) %}
        AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
        {% end %}

TYPE ENDPOINT
