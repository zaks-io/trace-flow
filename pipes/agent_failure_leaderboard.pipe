DESCRIPTION >
    Failure leaderboard: ranks (tool_name, command_family) by failure rate and
    event volume over a window. Lambda over `agent_tool_usage_1h` + the live tail of
    `agent_tool_events FINAL`: the watermark is the rollup's latest bucket start
    (max(BucketStart)); the rollup serves hours strictly below it, the base branch serves
    at/after it (incl. the latest partial hour, live), so a stale or partial rollup can never
    hide recent failures. The union is re-aggregated by (tool_name, command_family).
    Counts are exact either way (the tool rollup holds only count/sum states, no HLL).
    `failure_rate = failure / (success + failure)`; `unknown` is counted in
    `event_count` but excluded from the denominator (ADR "Failure semantics"). A display
    floor (`min_events`) keeps a rare tool off the top on a single failure. `org_id` is
    enforced via the JWT `fixed_params`.

NODE leaderboard
SQL >
    %
    WITH
        {{ Int64(start_time_ms, 0) }} AS start_ms,
        {{ Int64(end_time_ms, 0) }} AS end_ms,
        if(start_ms = 0, toDateTime64(now() - toIntervalDay(7), 3), fromUnixTimestamp64Milli(start_ms)) AS start_dt,
        if(end_ms = 0, toDateTime64(now(), 3), fromUnixTimestamp64Milli(end_ms)) AS end_dt,
        -- Lambda watermark = rollup's latest bucket start: rollup serves hours strictly below it,
        -- the base branch serves at/after it (incl. the latest partial hour). Empty rollup ->
        -- epoch -> base serves everything.
        (SELECT max(BucketStart) FROM agent_tool_usage_1h WHERE OrgId = {{ String(org_id, '') }}) AS rollup_watermark
    SELECT
        tool_name,
        command_family,
        sum(event_count) AS event_count,
        sum(success_count) AS success_count,
        sum(failure_count) AS failure_count,
        sum(unknown_count) AS unknown_count,
        if(
            success_count + failure_count = 0,
            CAST(NULL, 'Nullable(Float64)'),
            round(failure_count / (success_count + failure_count), 4)
        ) AS failure_rate
    FROM (
        SELECT
            tool_name,
            command_family,
            countMerge(EventCount) AS event_count,
            sumMerge(SuccessCount) AS success_count,
            sumMerge(FailureCount) AS failure_count,
            sumMerge(UnknownCount) AS unknown_count
        FROM agent_tool_usage_1h
        WHERE BucketStart < rollup_watermark
            AND OrgId = {{ String(org_id, '') }}
            AND BucketStart >= start_dt
            AND BucketStart < end_dt
            AND BucketStart >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
            {% if defined(sources) %}
            AND source IN splitByChar(',', {{ String(sources) }})
            {% end %}
            {% if defined(repos) %}
            AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
            {% end %}
            {% if defined(repo_fingerprint) %}
            AND repo_fingerprint = {{ String(repo_fingerprint) }}
            {% end %}
        GROUP BY tool_name, command_family

        UNION ALL

        SELECT
            tool_name,
            command_family,
            count() AS event_count,
            countIf(status = 'success') AS success_count,
            countIf(status = 'failure') AS failure_count,
            countIf(status = 'unknown') AS unknown_count
        FROM agent_tool_events FINAL
        WHERE EventAt >= rollup_watermark
            AND OrgId = {{ String(org_id, '') }}
            AND EventAt >= start_dt
            AND EventAt < end_dt
            AND EventAt >= now() - toIntervalDay({{ Int32(retention_days, 7) }})
            {% if defined(sources) %}
            AND source IN splitByChar(',', {{ String(sources) }})
            {% end %}
            {% if defined(repos) %}
            AND repo_fingerprint IN splitByChar(',', {{ String(repos) }})
            {% end %}
            {% if defined(repo_fingerprint) %}
            AND repo_fingerprint = {{ String(repo_fingerprint) }}
            {% end %}
        GROUP BY tool_name, command_family
    )
    GROUP BY tool_name, command_family
    HAVING event_count >= {{ Int32(min_events, 10) }}
    ORDER BY failure_rate DESC NULLS LAST, event_count DESC, tool_name ASC, command_family ASC
    LIMIT {{ Int32(limit, 100) }}

TYPE ENDPOINT
