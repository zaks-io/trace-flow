DESCRIPTION >
    Incremental Agent Session signal states from File Event facts.

NODE rollup
SQL >
    SELECT
        OrgId,
        repo_fingerprint,
        toDate(EventAt) AS EventDate,
        session_pk,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState('', toDateTime64(0, 3)) AS model,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        minState(EventAt) AS StartedAt,
        maxState(EventAt) AS LastEventAt,
        maxState(toDateTime64(0, 3)) AS VendorStartedAt,
        maxState(IngestedAt) AS IngestedAt,
        sumState(toUInt64(0)) AS MessageCount,
        sumState(toUInt64(0)) AS InputTokens,
        sumState(toUInt64(0)) AS OutputTokens,
        sumState(toUInt64(0)) AS CacheReadTokens,
        sumState(toUInt64(0)) AS CacheCreationTokens,
        sumState(toUInt64(0)) AS ReasoningTokens,
        sumState(toUInt64(0)) AS PricedMessageCount,
        sumState(toUInt64(0)) AS TokenCoveredMessageCount,
        sumState(toUInt64(0)) AS CacheCoveredMessageCount,
        sumState(toUInt64(0)) AS MissingModelMessageCount,
        sumState(toUInt64(toString(agent_file_event_facts.source) = '')) AS MissingSourceFactCount,
        sumState(toFloat64(0)) AS CostUsd,
        sumState(toUInt64(0)) AS ToolEventCount,
        sumState(toUInt64(0)) AS ToolSuccessCount,
        sumState(toUInt64(0)) AS ToolFailureCount,
        sumState(toUInt64(0)) AS ToolUnknownCount,
        sumState(toUInt64(0)) AS NavigationToolCount,
        sumState(toUInt64(0)) AS SearchToolCount,
        sumState(toUInt64(0)) AS NavigationHintStructuredCount,
        sumState(toUInt64(0)) AS NavigationHintUnknownCount,
        sumState(toUInt64(0)) AS MissingFileFailureCount,
        sumState(toUInt64(0)) AS ReadDirectoryFailureCount,
        sumState(toUInt64(0)) AS EditBeforeReadFailureCount,
        sumState(toUInt64(0)) AS StaleFileBeforeEditFailureCount,
        sumState(toUInt64(0)) AS ExternalSchemaValidationFailureCount,
        sumState(toUInt64(0)) AS RuntimeEnvMismatchFailureCount,
        sumState(toUInt64(0)) AS ToolInputValidationFailureCount,
        sumState(toUInt64(0)) AS HumanOrPolicyRejectionFailureCount,
        sumState(toUInt64(0)) AS WrongToolNameFailureCount,
        sumState(toUInt64(0)) AS OversizedReadFailureCount,
        sumState(toUInt64(0)) AS OtherFailureCount,
        sumState(toUInt64(0)) AS ClassifiedErrorCategoryFailureCount,
        sumState(toUInt64(0)) AS UnknownErrorCategoryFailureCount,
        sumState(toUInt64(1)) AS FileTouchCount,
        sumState(toUInt64(operation = 'read')) AS ReadFileTouchCount,
        sumState(toUInt64(operation = 'edit')) AS EditFileTouchCount,
        sumState(toUInt64(operation IN ('write', 'create', 'delete', 'rename'))) AS WriteFileTouchCount,
        uniqState(normalized_repo_path) AS UniqueFileCount,
        uniqStateIf('', 0) AS PullRequestLinkCount
    FROM agent_file_event_facts
    GROUP BY OrgId, repo_fingerprint, EventDate, session_pk

TYPE MATERIALIZED
DATASOURCE agent_session_signals
