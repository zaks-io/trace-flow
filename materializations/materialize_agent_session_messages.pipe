DESCRIPTION >
    Incremental session summary states from Agent Message facts.

NODE rollup
SQL >
    SELECT
        OrgId,
        session_pk,
        argMaxState(toString(source), EventAt) AS source,
        argMaxState(UserId, EventAt) AS UserId,
        argMaxState(CollectorId, EventAt) AS CollectorId,
        argMaxState(CollectorCredentialId, EventAt) AS CollectorCredentialId,
        argMaxState(repo_fingerprint, EventAt) AS repo_fingerprint,
        argMaxState(toString(repo_source), EventAt) AS repo_source,
        argMaxState(toString(model), EventAt) AS model,
        argMaxState(toString(parser_version), EventAt) AS parser_version,
        minState(EventAt) AS StartedAt,
        maxState(EventAt) AS LastEventAt,
        maxState(VendorStartedAt) AS VendorStartedAt,
        maxState(IngestedAt) AS IngestedAt,
        argMaxState(git_branch, EventAt) AS git_branch,
        argMaxState(git_head_sha, EventAt) AS git_head_sha,
        argMaxState('', toDateTime64(0, 3)) AS primary_pull_request_url,
        sumState(toUInt64(1)) AS MessageCount,
        sumState(toUInt64(0)) AS ToolEventCount,
        sumState(toUInt64(0)) AS FileEventCount,
        uniqStateIf('', 0) AS UniqueFileCount,
        sumState(toUInt64(0)) AS FailureCount,
        sumState(toUInt64(input_tokens)) AS InputTokens,
        sumState(toUInt64(output_tokens)) AS OutputTokens,
        sumState(toUInt64(cache_read_tokens)) AS CacheReadTokens,
        sumState(toUInt64(cache_creation_tokens)) AS CacheCreationTokens,
        sumState(toUInt64(reasoning_tokens)) AS ReasoningTokens,
        sumState(toUInt64(cost_usd IS NOT NULL)) AS PricedMessageCount,
        sumState(ifNull(cost_usd, 0.)) AS CostUsd
    FROM agent_message_facts
    WHERE role = 'assistant'
    GROUP BY OrgId, session_pk

TYPE MATERIALIZED
DATASOURCE agent_session_summaries
