DESCRIPTION >
    Non-aggregating delivery receipts from agent_tool_event_fact_versions. This view intentionally preserves
    tombstones because a partition-moving correction is durable only when both rows arrive.

NODE receipts
SQL >
    SELECT
        OrgId,
        DeliverySequence,
        'tool_events' AS Category,
        concat(OrgId, char(31), session_pk, char(31), tool_use_pk) AS FactIdentity,
        toDate(EventAt) AS EventDay,
        IsDeleted,
        ContentHash,
        now64(3) AS ReceivedAt
    FROM agent_tool_event_fact_versions

TYPE MATERIALIZED
DATASOURCE agent_delivery_receipts
