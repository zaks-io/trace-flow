{
  "name": "@trace-flow/sdk-tests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "integration": "bun run src/cli.ts run",
    "integration:openai": "bun run src/cli.ts run -p openai",
    "integration:anthropic": "bun run src/cli.ts run -p anthropic",
    "integration:google": "bun run src/cli.ts run -p google",
    "integration:openrouter": "bun run src/cli.ts run -p openrouter",
    "integration:groq": "bun run src/cli.ts run -p groq",
    "integration:groq-tools": "bun run src/cli.ts run -p groq -s tools",
    "integration:all": "bun run src/cli.ts run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/google": "latest",
    "@ai-sdk/groq": "latest",
    "@ai-sdk/openai": "latest",
    "@inkjs/ui": "^2.0.0",
    "@openrouter/ai-sdk-provider": "latest",
    "@trace-flow/utils": "workspace:*",
    "ai": "latest",
    "commander": "^12.0.0",
    "ink": "^6.8.0",
    "react": "^19.2.4",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "typescript": "^5"
  }
}
