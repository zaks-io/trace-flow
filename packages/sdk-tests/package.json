{
  "name": "@trace-flow/sdk-tests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "integration": "bun run src/cli.ts run",
    "integration:openai": "bun run src/cli.ts run -p openai",
    "integration:anthropic": "bun run src/cli.ts run -p anthropic",
    "integration:google": "bun run src/cli.ts run -p google",
    "integration:openrouter": "bun run src/cli.ts run -p openrouter",
    "integration:groq": "bun run src/cli.ts run -p groq",
    "integration:groq-tools": "bun run src/cli.ts run -p groq -s tools",
    "integration:all": "bun run src/cli.ts run",
    "bench": "bun run src/cli.ts bench",
    "bench:openai": "bun run src/cli.ts bench -p openai",
    "bench:anthropic": "bun run src/cli.ts bench -p anthropic",
    "bench:google": "bun run src/cli.ts bench -p google",
    "bench:openrouter": "bun run src/cli.ts bench -p openrouter",
    "bench:groq": "bun run src/cli.ts bench -p groq",
    "bench:all": "bun run src/cli.ts bench --all",
    "bench:report": "bun run src/cli.ts bench --all --markdown"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@ai-sdk/google": "^3.0.63",
    "@ai-sdk/groq": "^3.0.35",
    "@ai-sdk/openai": "^3.0.52",
    "@inkjs/ui": "^2.0.0",
    "@openrouter/ai-sdk-provider": "^2.5.1",
    "@trace-flow/utils": "workspace:*",
    "ai": "^6.0.159",
    "commander": "^12.1.0",
    "ink": "^6.8.0",
    "react": "^19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  }
}
