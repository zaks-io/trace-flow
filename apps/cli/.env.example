# Trace Flow Collector CLI — optional overrides (production URLs are the defaults).
# Copy to a local file and export, or prefix commands: env $(cat .env.local) trace-flow sync

# Convex site origin for `trace-flow login` (device flow).
# Default: https://laudable-bison-427.convex.site
# TRACE_FLOW_CONVEX_SITE_URL=http://127.0.0.1:3211

# Ingest Worker base URL for `trace-flow sync`.
# Default: https://collector.trace-flow.dev
# TRACE_FLOW_INGEST_URL=http://127.0.0.1:8787

# Headless/CI: Collector Credential secret (normally in OS keychain after login).
# TRACE_FLOW_COLLECTOR_SECRET=
