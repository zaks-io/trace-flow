{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker-entry.ts",
  "name": "trace-flow-web",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "logpush": true,
  "observability": {
    "traces": {
      "enabled": true,
      "destinations": ["axiom-traces"],
      "head_sampling_rate": 1,
    },
    "logs": {
      "enabled": true,
      "destinations": ["axiom-logs"],
      "head_sampling_rate": 1,
    },
  },
  "ai": {
    "binding": "AI",
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "ratelimits": [
    {
      "name": "TOKEN_REFRESH_LIMITER",
      "namespace_id": "2022",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "env": {
    // Offline build verification for scripts/verify-built-worker.sh. Named environments do not
    // inherit `ai`, and an AI binding always connects to Cloudflare, so CI runs without a token.
    "verify": {},
    "development": {
      "name": "trace-flow-web-dev",
      "workers_dev": true,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "ai": {
        "binding": "AI",
      },
      "vars": {
        "AXIOM_DATASET": "cloudflare",
        "SENTRY_ENVIRONMENT": "development",
      },
      "ratelimits": [
        {
          "name": "TOKEN_REFRESH_LIMITER",
          "namespace_id": "2022",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
    "preview": {
      "name": "trace-flow-web-preview",
      "workers_dev": true,
      "routes": [{ "pattern": "preview.trace-flow.dev", "custom_domain": true }],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "ai": {
        "binding": "AI",
      },
      "vars": {
        "AXIOM_DATASET": "cloudflare",
        "SENTRY_ENVIRONMENT": "preview",
        "APP_BASE_URL": "https://preview.trace-flow.dev",
      },
      "ratelimits": [
        {
          "name": "TOKEN_REFRESH_LIMITER",
          "namespace_id": "2023",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "trace-flow-web",
      "workers_dev": false,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "ai": {
        "binding": "AI",
      },
      "vars": {
        "AXIOM_DATASET": "cloudflare",
        "SENTRY_ENVIRONMENT": "prod",
      },
      "ratelimits": [
        {
          "name": "TOKEN_REFRESH_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
  },
}
