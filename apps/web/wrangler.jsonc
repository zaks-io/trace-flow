{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker-entry.ts",
  "name": "trace-flow-web",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "logpush": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
    },
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "ratelimits": [
    {
      "name": "TOKEN_REFRESH_LIMITER",
      "namespace_id": "2005",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "env": {
    "development": {
      "name": "trace-flow-web-dev",
      "workers_dev": true,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "AXIOM_DATASET": "cloudflare",
        "SENTRY_ENVIRONMENT": "development",
      },
      "ratelimits": [
        {
          "name": "TOKEN_REFRESH_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
    "preview": {
      "name": "trace-flow-web-preview",
      "workers_dev": true,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "AXIOM_DATASET": "cloudflare",
        "SENTRY_ENVIRONMENT": "preview",
      },
      "ratelimits": [
        {
          "name": "TOKEN_REFRESH_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "trace-flow-web",
      "workers_dev": false,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "AXIOM_DATASET": "cloudflare",
        "SENTRY_ENVIRONMENT": "prod",
      },
      "ratelimits": [
        {
          "name": "TOKEN_REFRESH_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
  },
}
