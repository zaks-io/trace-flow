{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker-entry.ts",
  "name": "trace-flow-web",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "logpush": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
    },
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "env": {
    "development": {
      "name": "trace-flow-web-dev",
      "workers_dev": true,
    },
    "production": {
      "name": "trace-flow-web",
      "workers_dev": false,
    },
  },
}
