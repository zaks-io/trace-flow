{
  "name": "@trace-flow/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env development",
    "deploy:prod": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "docs:generate": "bun run scripts/generate-docs-content.ts",
    "skills:generate": "bun run scripts/generate-agent-skills.ts",
    "pretype-check": "bun run docs:generate && bun run skills:generate",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.28.0",
    "@convex-dev/agent": "^0.6.4",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/cloudflare": "10.73.0",
    "@sentry/nextjs": "10.73.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@trace-flow/convex": "workspace:*",
    "@trace-flow/logging": "workspace:*",
    "@trace-flow/mcp-core": "workspace:*",
    "@trace-flow/otel-conventions": "workspace:*",
    "@trace-flow/spans": "workspace:*",
    "@trace-flow/tinybird-client": "workspace:*",
    "@trace-flow/types": "workspace:*",
    "@trace-flow/utils": "workspace:*",
    "ai": "^6.0.275",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.38.0",
    "launchdarkly-react-client-sdk": "^3.9.4",
    "lucide-react": "^0.563.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "license": "Apache-2.0"
}
