{
  "name": "@trace-flow/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env development",
    "deploy:prod": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "docs:generate": "bun run scripts/generate-docs-content.ts",
    "pretype-check": "bun run docs:generate",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e:agents:auth": "bun run scripts/save-agents-e2e-auth.ts",
    "test:e2e:agents": "playwright test --config=playwright.config.ts e2e/agents-dashboard.walkthrough.spec.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.20.0",
    "@convex-dev/agent": "^0.6.4",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/cloudflare": "10.53.1",
    "@sentry/nextjs": "10.53.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/query-sync-storage-persister": "^5.100.10",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-persist-client": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "@trace-flow/logging": "workspace:*",
    "@trace-flow/otel-conventions": "workspace:*",
    "@trace-flow/spans": "workspace:*",
    "@trace-flow/tinybird-client": "workspace:*",
    "@trace-flow/types": "workspace:*",
    "@trace-flow/utils": "workspace:*",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.38.0",
    "launchdarkly-react-client-sdk": "^3.9.1",
    "lucide-react": "^0.563.0",
    "next": "16.2.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@opennextjs/cloudflare": "^1.19.9",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.88.0"
  }
}
