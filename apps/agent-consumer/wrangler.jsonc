{
  // Agent ingest queue consumer. Drains AGENT_QUEUE, prices each Agent Message via the shared KV
  // catalog, and writes one batched insert per base agent_* datasource through the shared Tinybird
  // transport. Stateless: no batching Durable Object. Redelivery is safe because every base fact is
  // a ReplacingMergeTree(IngestedAt) keyed on a stable *_pk, so a re-POST collapses under FINAL.
  //
  // DELIBERATELY has no deploy / deploy:preview scripts: preview.yml deploys every app exposing a
  // `deploy:preview` task (`turbo run deploy:preview --filter=./apps/*`), and deploy.yml has no agent
  // job. Keeping the scripts off holds the 0d deploy-gate so this worker stays inert until 2e wires
  // the end-to-end path, lifts the gate, and adds the deploy + preview jobs.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trace-flow-agent-consumer-dev",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-27",
  "compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "SENTRY_ENVIRONMENT": "development",
    "TINYBIRD_HOST": "https://api.us-west-2.aws.tinybird.co",
  },
  // Secrets (set via `wrangler secret` / CI, never committed): TINYBIRD_TOKEN (DATASOURCE:APPEND
  // scope), SENTRY_DSN.
  //
  // MODEL_PRICING is the shared dev pricing catalog (same namespace the proxy consumer reads); the
  // models.dev import (2d) keeps it populated.
  "kv_namespaces": [{ "binding": "MODEL_PRICING", "id": "25a35f71a8d64884a8e8935056880dba" }],
  // Consumes the 0d-provisioned agent-ingest-dev queue; poison + exhausted-retry messages dead-letter
  // to agent-ingest-dlq-dev.
  "queues": {
    "consumers": [
      {
        "queue": "agent-ingest-dev",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_concurrency": 10,
        "max_retries": 5,
        "dead_letter_queue": "agent-ingest-dlq-dev",
      },
    ],
  },
}
