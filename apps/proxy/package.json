{
  "name": "@trace-flow/proxy",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@sentry/cloudflare": "^10.53.1",
    "@trace-flow/llm-providers": "workspace:*",
    "@trace-flow/logging": "workspace:*",
    "@trace-flow/types": "workspace:*",
    "@trace-flow/utils": "workspace:*",
    "eventsource-parser": "^3.0.8",
    "hono": "^4.12.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.14",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@vitest/coverage-istanbul": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.88.0"
  }
}
