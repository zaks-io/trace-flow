DESCRIPTION >
    Request-level facts extracted from LLM spans.
    One row per proxy request span with token and cost metrics.

SCHEMA >
    `ReceivedAt` Int64,
    `Timestamp` Int64,
    `TraceId` String,
    `SpanId` String,
    `ApiKey` LowCardinality(String),
    `Provider` LowCardinality(String),
    `Model` LowCardinality(String),
    `OperationName` LowCardinality(String),
    `BaggageOperation` LowCardinality(String),
    `StatusCode` LowCardinality(String),
    `InputTokens` UInt32,
    `OutputTokens` UInt32,
    `CacheReadInputTokens` UInt32,
    `CacheCreationInputTokens` UInt32,
    `ReasoningTokens` UInt32,
    `UncachedInputTokens` UInt32,
    `InputCostMicrodollars` UInt64,
    `OutputCostMicrodollars` UInt64,
    `CacheReadCostMicrodollars` UInt64,
    `CacheCreationCostMicrodollars` UInt64,
    `ReasoningCostMicrodollars` UInt64,
    `PromptBaselineCostMicrodollars` UInt64,
    `CacheImpactCostMicrodollars` Int64,
    `UpstreamCostMicrodollars` UInt64,
    `TotalCostMicrodollars` UInt64,
    `DurationNano` Int64,
    `TierAtIngestion` LowCardinality(String),
    `RetentionExpiresAt` Int64

ENGINE "MergeTree"
ENGINE_SORTING_KEY "ReceivedAt, ApiKey, Provider, Model, OperationName, StatusCode, TraceId, SpanId"
ENGINE_PARTITION_KEY "toYYYYMMDD(toDateTime(ReceivedAt / 1000000000))"
ENGINE_TTL "toDateTime(RetentionExpiresAt / 1000000000) + toIntervalDay(0)"

FORWARD_QUERY >
    SELECT ReceivedAt, Timestamp, TraceId, SpanId, ApiKey, Provider, Model, OperationName, BaggageOperation, StatusCode, InputTokens, OutputTokens, CacheReadInputTokens, CacheCreationInputTokens, ReasoningTokens, defaultValueOfTypeName('UInt32') AS UncachedInputTokens, InputCostMicrodollars, OutputCostMicrodollars, CacheReadCostMicrodollars, CacheCreationCostMicrodollars, ReasoningCostMicrodollars, defaultValueOfTypeName('UInt64') AS PromptBaselineCostMicrodollars, defaultValueOfTypeName('Int64') AS CacheImpactCostMicrodollars, defaultValueOfTypeName('UInt64') AS UpstreamCostMicrodollars, TotalCostMicrodollars, DurationNano, defaultValueOfTypeName('LowCardinality(String)') AS TierAtIngestion, defaultValueOfTypeName('Int64') AS RetentionExpiresAt
