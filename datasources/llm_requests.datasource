DESCRIPTION >
    Request-level facts extracted from LLM spans.
    One row per proxy request span with token and cost metrics.

SCHEMA >
    `ReceivedAt` Int64,
    `Timestamp` Int64,
    `TraceId` String,
    `SpanId` String,
    `ApiKey` LowCardinality(String),
    `Provider` LowCardinality(String),
    `Model` LowCardinality(String),
    `OperationName` LowCardinality(String),
    `BaggageOperation` LowCardinality(String),
    `BaggageUserId` LowCardinality(String),
    `StatusCode` LowCardinality(String),
    `InputTokens` UInt32,
    `OutputTokens` UInt32,
    `CacheReadInputTokens` UInt32,
    `CacheCreationInputTokens` UInt32,
    `ReasoningTokens` UInt32,
    `UncachedInputTokens` UInt32,
    `InputCostMicrodollars` UInt64,
    `OutputCostMicrodollars` UInt64,
    `CacheReadCostMicrodollars` UInt64,
    `CacheCreationCostMicrodollars` UInt64,
    `ReasoningCostMicrodollars` UInt64,
    `PromptBaselineCostMicrodollars` UInt64,
    `CacheImpactCostMicrodollars` Int64,
    `UpstreamCostMicrodollars` UInt64,
    `TotalCostMicrodollars` UInt64,
    `DurationNano` Int64,
    `ProxyOverheadNano` Int64,
    `UpstreamTtfbNano` Int64,
    `TierAtIngestion` LowCardinality(String),
    `RetentionExpiresAt` Int64

FORWARD_QUERY >
    SELECT ReceivedAt, Timestamp, TraceId, SpanId, ApiKey, Provider, Model, OperationName, BaggageOperation, '' AS BaggageUserId, StatusCode, InputTokens, OutputTokens, CacheReadInputTokens, CacheCreationInputTokens, ReasoningTokens, UncachedInputTokens, InputCostMicrodollars, OutputCostMicrodollars, CacheReadCostMicrodollars, CacheCreationCostMicrodollars, ReasoningCostMicrodollars, PromptBaselineCostMicrodollars, CacheImpactCostMicrodollars, UpstreamCostMicrodollars, TotalCostMicrodollars, DurationNano, ProxyOverheadNano, UpstreamTtfbNano, TierAtIngestion, RetentionExpiresAt

ENGINE "ReplacingMergeTree"
ENGINE_SORTING_KEY "ReceivedAt, ApiKey, Provider, Model, OperationName, BaggageOperation, StatusCode, BaggageUserId, TraceId, SpanId"
ENGINE_PARTITION_KEY "toYYYYMMDD(toDateTime(ReceivedAt / 1000000000))"
ENGINE_TTL "toDateTime(RetentionExpiresAt / 1000000000) + toIntervalDay(0)"
