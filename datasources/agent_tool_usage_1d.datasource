DESCRIPTION >
    Daily rolling snapshots of Tool Event mix and outcomes, by org/source/tool/
    command_family/repo. The copy pipe replaces this target with the current rebuild
    window, so stale day/dimension rows disappear when noisy base facts dedupe or
    dimensions heal.

SCHEMA >
    `BucketStart` DateTime,
    `OrgId` String,
    `source` LowCardinality(String),
    `tool_name` LowCardinality(String),
    `command_family` LowCardinality(String),
    `repo_fingerprint` String,
    `EventCount` UInt64,
    `SuccessCount` UInt64,
    `FailureCount` UInt64,
    `UnknownCount` UInt64,
    `DurationMsSum` UInt64,
    `RebuiltAt` DateTime64(3)

FORWARD_QUERY >
    SELECT
        BucketStart,
        OrgId,
        source,
        tool_name,
        command_family,
        repo_fingerprint,
        toUInt64(finalizeAggregation(EventCount)) AS EventCount,
        toUInt64(finalizeAggregation(SuccessCount)) AS SuccessCount,
        toUInt64(finalizeAggregation(FailureCount)) AS FailureCount,
        toUInt64(finalizeAggregation(UnknownCount)) AS UnknownCount,
        toUInt64(finalizeAggregation(DurationMsSum)) AS DurationMsSum,
        defaultValueOfTypeName('DateTime64(3)') AS RebuiltAt

ENGINE "MergeTree"
ENGINE_SORTING_KEY "OrgId, BucketStart, source, tool_name, command_family, repo_fingerprint"
ENGINE_PARTITION_KEY "toYYYYMM(BucketStart)"
ENGINE_TTL "BucketStart + toIntervalYear(1)"
