DESCRIPTION >
    Hourly rolling snapshots of Agent Message usage and cost, by org/source/model/repo.
    The copy pipe replaces this target with the current rebuild window, so stale
    bucket/dimension rows disappear when noisy base facts dedupe or dimensions heal.
    SessionCount stays an aggregate state so rollups across model or repo can merge
    distinct sessions without double-counting.

SCHEMA >
    `BucketStart` DateTime,
    `OrgId` String,
    `source` LowCardinality(String),
    `model` LowCardinality(String),
    `repo_fingerprint` String,
    `MessageCount` UInt64,
    `SessionCount` AggregateFunction(uniq, String),
    `InputTokens` UInt64,
    `OutputTokens` UInt64,
    `CacheReadTokens` UInt64,
    `CacheCreationTokens` UInt64,
    `ReasoningTokens` UInt64,
    `PricedMessageCount` UInt64,
    `CostUsd` Float64,
    `RebuiltAt` DateTime64(3)

FORWARD_QUERY >
    SELECT
        BucketStart,
        OrgId,
        source,
        model,
        repo_fingerprint,
        toUInt64(finalizeAggregation(MessageCount)) AS MessageCount,
        SessionCount,
        toUInt64(finalizeAggregation(InputTokens)) AS InputTokens,
        toUInt64(finalizeAggregation(OutputTokens)) AS OutputTokens,
        toUInt64(finalizeAggregation(CacheReadTokens)) AS CacheReadTokens,
        toUInt64(finalizeAggregation(CacheCreationTokens)) AS CacheCreationTokens,
        toUInt64(finalizeAggregation(ReasoningTokens)) AS ReasoningTokens,
        toUInt64(finalizeAggregation(PricedMessageCount)) AS PricedMessageCount,
        toFloat64(finalizeAggregation(CostUsd)) AS CostUsd,
        defaultValueOfTypeName('DateTime64(3)') AS RebuiltAt

ENGINE "MergeTree"
ENGINE_SORTING_KEY "OrgId, BucketStart, source, model, repo_fingerprint"
ENGINE_PARTITION_KEY "toYYYYMM(BucketStart)"
ENGINE_TTL "BucketStart + toIntervalYear(1)"
