DESCRIPTION >
    Incremental Agent Session optimization-signal serving table. Event-date
    buckets prune bounded reads while endpoints merge back to one row per
    organization, Repo, and Agent Session without scanning raw fact tables.

SCHEMA >
    `OrgId` String,
    `repo_fingerprint` String,
    `EventDate` Date,
    `session_pk` String,
    `source` AggregateFunction(argMax, String, DateTime64(3)),
    `repo_source` AggregateFunction(argMax, String, DateTime64(3)),
    `model` AggregateFunction(argMax, String, DateTime64(3)),
    `parser_version` AggregateFunction(argMax, String, DateTime64(3)),
    `StartedAt` AggregateFunction(min, DateTime64(3)),
    `LastEventAt` AggregateFunction(max, DateTime64(3)),
    `VendorStartedAt` AggregateFunction(max, DateTime64(3)),
    `IngestedAt` AggregateFunction(max, DateTime64(3)),
    `MessageCount` AggregateFunction(sum, UInt64),
    `InputTokens` AggregateFunction(sum, UInt64),
    `OutputTokens` AggregateFunction(sum, UInt64),
    `CacheReadTokens` AggregateFunction(sum, UInt64),
    `CacheCreationTokens` AggregateFunction(sum, UInt64),
    `ReasoningTokens` AggregateFunction(sum, UInt64),
    `PricedMessageCount` AggregateFunction(sum, UInt64),
    `TokenCoveredMessageCount` AggregateFunction(sum, UInt64),
    `CacheCoveredMessageCount` AggregateFunction(sum, UInt64),
    `MissingModelMessageCount` AggregateFunction(sum, UInt64),
    `MissingSourceFactCount` AggregateFunction(sum, UInt64),
    `CostUsd` AggregateFunction(sum, Float64),
    `ToolEventCount` AggregateFunction(sum, UInt64),
    `ToolSuccessCount` AggregateFunction(sum, UInt64),
    `ToolFailureCount` AggregateFunction(sum, UInt64),
    `ToolUnknownCount` AggregateFunction(sum, UInt64),
    `NavigationToolCount` AggregateFunction(sum, UInt64),
    `SearchToolCount` AggregateFunction(sum, UInt64),
    `NavigationHintStructuredCount` AggregateFunction(sum, UInt64),
    `NavigationHintUnknownCount` AggregateFunction(sum, UInt64),
    `MissingFileFailureCount` AggregateFunction(sum, UInt64),
    `ReadDirectoryFailureCount` AggregateFunction(sum, UInt64),
    `EditBeforeReadFailureCount` AggregateFunction(sum, UInt64),
    `StaleFileBeforeEditFailureCount` AggregateFunction(sum, UInt64),
    `ExternalSchemaValidationFailureCount` AggregateFunction(sum, UInt64),
    `RuntimeEnvMismatchFailureCount` AggregateFunction(sum, UInt64),
    `ToolInputValidationFailureCount` AggregateFunction(sum, UInt64),
    `HumanOrPolicyRejectionFailureCount` AggregateFunction(sum, UInt64),
    `WrongToolNameFailureCount` AggregateFunction(sum, UInt64),
    `OversizedReadFailureCount` AggregateFunction(sum, UInt64),
    `OtherFailureCount` AggregateFunction(sum, UInt64),
    `ClassifiedErrorCategoryFailureCount` AggregateFunction(sum, UInt64),
    `UnknownErrorCategoryFailureCount` AggregateFunction(sum, UInt64),
    `FileTouchCount` AggregateFunction(sum, UInt64),
    `ReadFileTouchCount` AggregateFunction(sum, UInt64),
    `EditFileTouchCount` AggregateFunction(sum, UInt64),
    `WriteFileTouchCount` AggregateFunction(sum, UInt64),
    `UniqueFileCount` AggregateFunction(uniq, String),
    `PullRequestLinkCount` AggregateFunction(uniq, String)

ENGINE "AggregatingMergeTree"
ENGINE_SORTING_KEY "OrgId, repo_fingerprint, EventDate, session_pk"
ENGINE_PARTITION_KEY "toYYYYMM(EventDate)"

FORWARD_QUERY >
    SELECT
        OrgId,
        repo_fingerprint,
        toDate('1970-01-01') AS EventDate,
        session_pk,
        source,
        repo_source,
        model,
        parser_version,
        StartedAt,
        LastEventAt,
        VendorStartedAt,
        IngestedAt,
        MessageCount,
        InputTokens,
        OutputTokens,
        CacheReadTokens,
        CacheCreationTokens,
        ReasoningTokens,
        PricedMessageCount,
        TokenCoveredMessageCount,
        CacheCoveredMessageCount,
        MissingModelMessageCount,
        MissingSourceFactCount,
        CostUsd,
        ToolEventCount,
        ToolSuccessCount,
        ToolFailureCount,
        ToolUnknownCount,
        NavigationToolCount,
        SearchToolCount,
        NavigationHintStructuredCount,
        NavigationHintUnknownCount,
        MissingFileFailureCount,
        ReadDirectoryFailureCount,
        EditBeforeReadFailureCount,
        StaleFileBeforeEditFailureCount,
        ExternalSchemaValidationFailureCount,
        RuntimeEnvMismatchFailureCount,
        ToolInputValidationFailureCount,
        HumanOrPolicyRejectionFailureCount,
        WrongToolNameFailureCount,
        OversizedReadFailureCount,
        OtherFailureCount,
        ClassifiedErrorCategoryFailureCount,
        UnknownErrorCategoryFailureCount,
        FileTouchCount,
        ReadFileTouchCount,
        EditFileTouchCount,
        WriteFileTouchCount,
        UniqueFileCount,
        PullRequestLinkCount
