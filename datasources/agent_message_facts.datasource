DESCRIPTION >
    One Agent Message (model-call turn) parsed from a local agent transcript.
    Direct model-call tokens and server-estimated cost. Mirrors the llm_request_facts
    pattern but keeps turn grain. Token/cache columns are non-null (0 when absent);
    token_coverage / cache_coverage explain missing source data. cost_usd is the
    only Nullable column (null = unpriced model or missing token coverage).
    EventAt/IngestedAt/VendorStartedAt are DateTime64(3): transcript-parsed facts
    have no nanosecond source, so partition/TTL read the column directly.
    JSONPaths are defined because the consumer POSTs rows here via /v0/events;
    keys match column names exactly (the ingest contract for this fact table).

SCHEMA >
    `OrgId` String `json:$.OrgId`,
    `UserId` String `json:$.UserId`,
    `CollectorId` String `json:$.CollectorId`,
    `CollectorCredentialId` String `json:$.CollectorCredentialId`,
    `session_pk` String `json:$.session_pk`,
    `message_pk` String `json:$.message_pk`,
    `repo_fingerprint` String `json:$.repo_fingerprint`,
    `repo_source` LowCardinality(String) `json:$.repo_source`,
    `source` LowCardinality(String) `json:$.source`,
    `parser_version` LowCardinality(String) `json:$.parser_version`,
    `EventAt` DateTime64(3) `json:$.EventAt`,
    `IngestedAt` DateTime64(3) `json:$.IngestedAt`,
    `VendorStartedAt` DateTime64(3) `json:$.VendorStartedAt`,
    `vendor_session_id` String `json:$.vendor_session_id`,
    `vendor_message_id` String `json:$.vendor_message_id`,
    `turn_index` UInt32 `json:$.turn_index`,
    `role` LowCardinality(String) `json:$.role`,
    `model` LowCardinality(String) `json:$.model`,
    `input_tokens` UInt32 `json:$.input_tokens`,
    `output_tokens` UInt32 `json:$.output_tokens`,
    `cache_read_tokens` UInt32 `json:$.cache_read_tokens`,
    `cache_creation_tokens` UInt32 `json:$.cache_creation_tokens`,
    `cache_creation_5m_tokens` UInt32 `json:$.cache_creation_5m_tokens`,
    `cache_creation_1h_tokens` UInt32 `json:$.cache_creation_1h_tokens`,
    `reasoning_tokens` UInt32 `json:$.reasoning_tokens`,
    `token_coverage` LowCardinality(String) `json:$.token_coverage`,
    `cache_coverage` LowCardinality(String) `json:$.cache_coverage`,
    `agent_depth` UInt8 `json:$.agent_depth`,
    `is_subagent_spawn` UInt8 `json:$.is_subagent_spawn`,
    `is_sidechain` UInt8 `json:$.is_sidechain`,
    `agent_id` String `json:$.agent_id`,
    `normalized_git_remote` String `json:$.normalized_git_remote`,
    `repo_path_fallback` String `json:$.repo_path_fallback`,
    `git_branch` String `json:$.git_branch`,
    `git_head_sha` String `json:$.git_head_sha`,
    `dropped_sensitive` UInt32 `json:$.dropped_sensitive`,
    `cost_usd` Nullable(Float64) `json:$.cost_usd`

ENGINE "MergeTree"
ENGINE_SORTING_KEY "OrgId, session_pk, message_pk"
ENGINE_PARTITION_KEY "toYYYYMMDD(EventAt)"
ENGINE_TTL "toDateTime(EventAt) + toIntervalYear(1)"

TOKEN "agent_consumer_append" APPEND
