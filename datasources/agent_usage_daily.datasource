DESCRIPTION >
    Daily Agent Message usage rollup, maintained incrementally from clean message facts.

SCHEMA >
    `BucketStart` DateTime,
    `OrgId` String,
    `source` LowCardinality(String),
    `model` LowCardinality(String),
    `repo_fingerprint` String,
    `MessageCount` AggregateFunction(count),
    `SessionCount` AggregateFunction(uniq, String),
    `InputTokens` AggregateFunction(sum, UInt64),
    `OutputTokens` AggregateFunction(sum, UInt64),
    `CacheReadTokens` AggregateFunction(sum, UInt64),
    `CacheCreationTokens` AggregateFunction(sum, UInt64),
    `ReasoningTokens` AggregateFunction(sum, UInt64),
    `PricedMessageCount` AggregateFunction(sum, UInt64),
    `CostUsd` AggregateFunction(sum, Float64)

ENGINE "AggregatingMergeTree"
ENGINE_SORTING_KEY "OrgId, BucketStart, source, model, repo_fingerprint"
ENGINE_PARTITION_KEY "toYYYYMM(BucketStart)"
ENGINE_TTL "BucketStart + toIntervalYear(1)"
