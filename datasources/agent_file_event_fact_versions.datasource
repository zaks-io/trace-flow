DESCRIPTION >
    One file touch, repo-relative only (privacy + worktree-stability guard).
    normalized_repo_path is repo-relative or the coarse `outside_repo` category;
    never an absolute path, never $HOME. Drives repeated-path attention and
    hotspot views.
    JSONPaths are defined because the consumer POSTs rows here via /v0/events;
    keys match column names exactly (the ingest contract for this fact table).

SCHEMA >
    `DeliverySequence` UInt64 `json:$.DeliverySequence`,
    `ContentHash` String `json:$.ContentHash`,
    `IsDeleted` UInt8 `json:$.IsDeleted`,
    `OrgId` String `json:$.OrgId`,
    `UserId` String `json:$.UserId`,
    `CollectorId` String `json:$.CollectorId`,
    `CollectorCredentialId` String `json:$.CollectorCredentialId`,
    `session_pk` String `json:$.session_pk`,
    `file_event_pk` String `json:$.file_event_pk`,
    `repo_fingerprint` String `json:$.repo_fingerprint`,
    `repo_source` LowCardinality(String) `json:$.repo_source`,
    `source` LowCardinality(String) `json:$.source`,
    `parser_version` LowCardinality(String) `json:$.parser_version`,
    `EventAt` DateTime64(3) `json:$.EventAt`,
    `IngestedAt` DateTime64(3) `json:$.IngestedAt`,
    `vendor_session_id` String `json:$.vendor_session_id`,
    `vendor_message_id` String `json:$.vendor_message_id`,
    `source_block_index` UInt32 `json:$.source_block_index`,
    `normalized_repo_path` String `json:$.normalized_repo_path`,
    `operation` LowCardinality(String) `json:$.operation`,
    `dropped_sensitive` UInt32 `json:$.dropped_sensitive`

ENGINE "ReplacingMergeTree"
ENGINE_SORTING_KEY "OrgId, toDate(EventAt), session_pk, file_event_pk"
ENGINE_VER "DeliverySequence"
ENGINE_IS_DELETED "IsDeleted"
ENGINE_PARTITION_KEY "toYYYYMM(EventAt)"
ENGINE_TTL "toDateTime(EventAt) + toIntervalYear(1)"

TOKEN "agent_consumer_versions_append" APPEND
TOKEN "agent_snapshot_migration" APPEND
TOKEN trace_flow_agent_facts_append APPEND
