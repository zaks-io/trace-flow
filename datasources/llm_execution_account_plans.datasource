DESCRIPTION >
    Subscription plan reported for an upstream account by each imported CLIProxyAPI execution that
    carried one. Kept apart from llm_execution_accounts so adding it only creates resources and never
    rewrites existing account history. One row per execution keeps retention identical to its source.

SCHEMA >
    `ReceivedAt` Int64,
    `Timestamp` Int64,
    `ApiKey` LowCardinality(String),
    `AccountKey` String,
    `Plan` LowCardinality(String),
    `RetentionExpiresAt` Int64

ENGINE "MergeTree"
ENGINE_SORTING_KEY "ApiKey, ReceivedAt, AccountKey"
ENGINE_PARTITION_KEY "toYYYYMMDD(toDateTime(ReceivedAt / 1000000000))"
ENGINE_TTL "toDateTime(RetentionExpiresAt / 1000000000) + toIntervalDay(0)"
