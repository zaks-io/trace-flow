DESCRIPTION >
    Hourly rollups of LLM request usage and cost metrics.
    Aggregated from llm_requests.

SCHEMA >
    `BucketStart` DateTime,
    `ApiKey` LowCardinality(String),
    `Provider` LowCardinality(String),
    `Model` LowCardinality(String),
    `OperationName` LowCardinality(String),
    `BaggageOperation` LowCardinality(String),
    `StatusCode` LowCardinality(String),
    `RequestCount` AggregateFunction(count),
    `InputTokens` AggregateFunction(sum, UInt64),
    `OutputTokens` AggregateFunction(sum, UInt64),
    `CacheReadInputTokens` AggregateFunction(sum, UInt64),
    `CacheCreationInputTokens` AggregateFunction(sum, UInt64),
    `ReasoningTokens` AggregateFunction(sum, UInt64),
    `UncachedInputTokens` AggregateFunction(sum, UInt64),
    `InputCostMicrodollars` AggregateFunction(sum, UInt64),
    `OutputCostMicrodollars` AggregateFunction(sum, UInt64),
    `CacheReadCostMicrodollars` AggregateFunction(sum, UInt64),
    `CacheCreationCostMicrodollars` AggregateFunction(sum, UInt64),
    `ReasoningCostMicrodollars` AggregateFunction(sum, UInt64),
    `PromptBaselineCostMicrodollars` AggregateFunction(sum, UInt64),
    `CacheImpactCostMicrodollars` AggregateFunction(sum, Int64),
    `UpstreamCostMicrodollars` AggregateFunction(sum, UInt64),
    `TotalCostMicrodollars` AggregateFunction(sum, UInt64),
    `AvgDurationNano` AggregateFunction(avg, Int64),
    `MaxDurationNano` AggregateFunction(max, Int64),
    `P95DurationNano` AggregateFunction(quantile(0.95), Int64)

ENGINE "AggregatingMergeTree"
ENGINE_SORTING_KEY "BucketStart, ApiKey, Provider, Model, OperationName, BaggageOperation, StatusCode"
ENGINE_PARTITION_KEY "toYYYYMM(BucketStart)"
ENGINE_TTL "BucketStart + INTERVAL 90 DAY"

FORWARD_QUERY >
    SELECT BucketStart, ApiKey, Provider, Model, OperationName, BaggageOperation, StatusCode, RequestCount, InputTokens, OutputTokens, CacheReadInputTokens, CacheCreationInputTokens, ReasoningTokens, initializeAggregation('sumState', toUInt64(0)) AS UncachedInputTokens, InputCostMicrodollars, OutputCostMicrodollars, CacheReadCostMicrodollars, CacheCreationCostMicrodollars, ReasoningCostMicrodollars, initializeAggregation('sumState', toUInt64(0)) AS PromptBaselineCostMicrodollars, initializeAggregation('sumState', toInt64(0)) AS CacheImpactCostMicrodollars, initializeAggregation('sumState', toUInt64(0)) AS UpstreamCostMicrodollars, TotalCostMicrodollars, AvgDurationNano, MaxDurationNano, P95DurationNano
